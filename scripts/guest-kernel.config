# rvvm-ios guest kernel config fragment (riscv64)
#
# Merged on top of `make ARCH=riscv defconfig` by scripts/build-guest-kernel.sh.
# Everything the RVVM machine provides must be BUILT-IN (=y): RVVM has no
# initrd support, so there is no initramfs to load modules from.
#
# Venus (virtio-gpu Vulkan) needs DRM_VIRTIO_GPU with blob resource support
# (kernel >= 5.16, we build a modern stable).

# --- Platform ---
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_FPU=y
CONFIG_SMP=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=y
CONFIG_NONPORTABLE=y

# --- Virtio core + transports (RVVM: virtio-mmio devices, virtio-pci NVMe) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y

# --- Block: RVVM NVMe controller + virtio-blk ---
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_NVME_CORE=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_LOOP=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_OVERLAY_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y

# --- Display: virtio-gpu 2D + venus blob resources ---
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_VGA_CONSOLE=y

# --- Input: virtio-input (keyboard/mouse/touchscreen) ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_LIBPS2=y

# --- Serial console (RVVM ns16550a on the FDT) ---
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DEPRECATED_OPTIONS=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_VIRTIO_CONSOLE=y

# --- Networking (RVVM rtl8169 PCI NIC + virtio-net) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_R8169=y
CONFIG_VIRTIO_NET=y

# --- Misc needed by userspace benchmarks ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SHMEM=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_KEYS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KSM=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_VIRTIO_DMA=y
