+/*
+virtio-gpu.c - virtio-gpu device (2D + venus 3D via virglrenderer/MoltenVK)
+Ported/created for rvvm-ios: cross-platform virtio GPU over virtio-mmio transport.
+
+This implements the virtio-gpu 2D feature set (scanout, resources, transfers,
+flushes, cursors, EDID) presenting through rvvm_fbdev, plus an optional bridge
+to virglrenderer for venus (Vulkan) host-side GPU acceleration.
+*/
+
+#include "virtio-gpu.h"
+
+#include "threading.h"
+
+#include "fdtlib.h"
+#include "mem_ops.h"
+#include "spinlock.h"
+#include "utils.h"
+#include "vector.h"
+#include "vma_ops.h"
+
+#include <rvvm/rvvm_fb.h>
+#include <rvvm/rvvm_snapshot.h>
+
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * 3D acceleration: venus (Vulkan serialization) over virglrenderer's venus
+ * renderer. The renderer is dlopen()ed at runtime; on iOS it is built against
+ * MoltenVK (Vulkan over Metal), elsewhere against any host Vulkan driver.
+ * 2D always works without it. All 3D acceleration flows through virglrenderer:
+ * venus is the 3D protocol we implement.
+ */
+#include <dlfcn.h>
+#include <sys/uio.h>
+#define VG_VENUS_BRIDGE 1
+#define VG_VENUS_CAPSET_VIRGL  1
+#define VG_VENUS_CAPSET_VIRGL2 2
+#define VG_VENUS_CAPSET_VENUS  3
+
+/*
+ * Virtio-MMIO register offsets (same layout as virtio-fs/virtio-input devices)
+ */
+enum {
+    VIRTIO_MMIO_MAGIC               = 0x000,
+    VIRTIO_MMIO_VERSION             = 0x004,
+    VIRTIO_MMIO_DEVICE_ID           = 0x008,
+    VIRTIO_MMIO_VENDOR_ID           = 0x00c,
+    VIRTIO_MMIO_DEVICE_FEATURES     = 0x010,
+    VIRTIO_MMIO_DEVICE_FEATURES_SEL = 0x014,
+    VIRTIO_MMIO_DRIVER_FEATURES     = 0x020,
+    VIRTIO_MMIO_DRIVER_FEATURES_SEL = 0x024,
+    VIRTIO_MMIO_QUEUE_SEL           = 0x030,
+    VIRTIO_MMIO_QUEUE_NUM_MAX       = 0x034,
+    VIRTIO_MMIO_QUEUE_NUM           = 0x038,
+    VIRTIO_MMIO_QUEUE_READY         = 0x044,
+    VIRTIO_MMIO_QUEUE_NOTIFY        = 0x050,
+    VIRTIO_MMIO_INTERRUPT_STATUS    = 0x060,
+    VIRTIO_MMIO_INTERRUPT_ACK       = 0x064,
+    VIRTIO_MMIO_STATUS              = 0x070,
+    VIRTIO_MMIO_QUEUE_DESC_LOW      = 0x080,
+    VIRTIO_MMIO_QUEUE_DESC_HIGH     = 0x084,
+    VIRTIO_MMIO_QUEUE_AVAIL_LOW     = 0x090,
+    VIRTIO_MMIO_QUEUE_AVAIL_HIGH    = 0x094,
+    VIRTIO_MMIO_QUEUE_USED_LOW      = 0x0a0,
+    VIRTIO_MMIO_QUEUE_USED_HIGH     = 0x0a4,
+    VIRTIO_MMIO_SHM_SEL             = 0x0ac,
+    VIRTIO_MMIO_SHM_LEN_LOW         = 0x0b0,
+    VIRTIO_MMIO_SHM_LEN_HIGH        = 0x0b4,
+    VIRTIO_MMIO_SHM_BASE_LOW        = 0x0b8,
+    VIRTIO_MMIO_SHM_BASE_HIGH       = 0x0bc,
+    VIRTIO_MMIO_CONFIG_GENERATION   = 0x0fc,
+    VIRTIO_MMIO_CONFIG              = 0x100,
+};
+
+enum {
+    VIRTQ_DESC_F_NEXT     = 1,
+    VIRTQ_DESC_F_WRITE    = 2,
+    VIRTQ_DESC_F_INDIRECT = 4,
+};
+
+enum {
+    VIRTIO_STATUS_ACK     = 1,
+    VIRTIO_STATUS_DRIVER  = 2,
+    VIRTIO_STATUS_DRIVER_OK = 4,
+    VIRTIO_STATUS_FEATURES_OK = 8,
+    VIRTIO_STATUS_FAILED  = 128,
+    VIRTIO_STATUS_DEVICE_NEEDS_RESET = 64,
+};
+
+#define VIRTIO_ID_GPU          0x10
+#define VIRTIO_MMIO_VENDOR_VALUE 0x5256564d // "RVVM"
+
+/*
+ * Feature bits
+ */
+#define VIRTIO_F_VERSION_1          32
+#define VIRTIO_RING_F_INDIRECT_DESC 28
+#define VIRTIO_RING_F_EVENT_IDX     29
+#define VIRTIO_GPU_F_VIRGL          0
+#define VIRTIO_GPU_F_EDID           1
+#define VIRTIO_GPU_F_RESOURCE_UUID  2
+#define VIRTIO_GPU_F_RESOURCE_BLOB  3
+#define VIRTIO_GPU_F_CONTEXT_INIT   4
+
+/*
+ * virtio-gpu commands
+ */
+enum {
+    VIRTIO_GPU_CMD_GET_DISPLAY_INFO   = 0x0100,
+    VIRTIO_GPU_CMD_RESOURCE_CREATE_2D = 0x0101,
+    VIRTIO_GPU_CMD_RESOURCE_UNREF     = 0x0102,
+    VIRTIO_GPU_CMD_SET_SCANOUT        = 0x0103,
+    VIRTIO_GPU_CMD_RESOURCE_FLUSH     = 0x0104,
+    VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D = 0x0105,
+    VIRTIO_GPU_CMD_RESOURCE_ATTACH_BACKING = 0x0106,
+    VIRTIO_GPU_CMD_RESOURCE_DETACH_BACKING = 0x0107,
+    VIRTIO_GPU_CMD_GET_CAPSET_INFO    = 0x0108,
+    VIRTIO_GPU_CMD_GET_CAPSET         = 0x0109,
+    VIRTIO_GPU_CMD_GET_EDID           = 0x0120,
+    VIRTIO_GPU_CMD_CTX_CREATE         = 0x0110,
+    VIRTIO_GPU_CMD_CTX_DESTROY        = 0x0111,
+    VIRTIO_GPU_CMD_CTX_ATTACH_RESOURCE = 0x0112,
+    VIRTIO_GPU_CMD_CTX_DETACH_RESOURCE = 0x0113,
+    VIRTIO_GPU_CMD_RESOURCE_CREATE_3D = 0x0114,
+    VIRTIO_GPU_CMD_TRANSFER_TO_HOST_3D = 0x0115,
+    VIRTIO_GPU_CMD_TRANSFER_FROM_HOST_3D = 0x0116,
+    VIRTIO_GPU_CMD_SUBMIT_3D          = 0x0117,
+    VIRTIO_GPU_CMD_RESOURCE_MAP_BLOB  = 0x0118,
+    VIRTIO_GPU_CMD_RESOURCE_UNMAP_BLOB = 0x0119,
+    VIRTIO_GPU_CMD_SET_SCANOUT_BLOB   = 0x011a,
+    VIRTIO_GPU_CMD_RESOURCE_ASSIGN_UUID = 0x011b,
+    VIRTIO_GPU_CMD_RESOURCE_CREATE_BLOB = 0x011c,
+    VIRTIO_GPU_CMD_UPDATE_CURSOR      = 0x0300,
+    VIRTIO_GPU_CMD_MOVE_CURSOR        = 0x0301,
+};
+
+enum {
+    VIRTIO_GPU_RESP_OK_NODATA          = 0x8000,
+    VIRTIO_GPU_RESP_OK_DISPLAY_INFO    = 0x8100,
+    VIRTIO_GPU_RESP_OK_CAPSET_INFO     = 0x8102,
+    VIRTIO_GPU_RESP_OK_CAPSET          = 0x8103,
+    VIRTIO_GPU_RESP_OK_EDID            = 0x8104,
+    VIRTIO_GPU_RESP_OK_RESOURCE_UUID   = 0x8105,
+    VIRTIO_GPU_RESP_OK_MAP_INFO        = 0x8106,
+    VIRTIO_GPU_RESP_ERR_UNSPEC         = 0x8200,
+    VIRTIO_GPU_RESP_ERR_OUT_OF_MEMORY  = 0x8201,
+    VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID = 0x8202,
+    VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID = 0x8203,
+    VIRTIO_GPU_RESP_ERR_INVALID_CONTEXT_ID  = 0x8204,
+    VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER   = 0x8205,
+
+    VIRTIO_GPU_BLOB_MEM_GUEST        = 0x0001,
+    VIRTIO_GPU_BLOB_MEM_HOST3D       = 0x0002,
+    VIRTIO_GPU_BLOB_MEM_HOST3D_GUEST = 0x0003,
+    VIRTIO_GPU_BLOB_MEM_GUEST_VRAM   = 0x0004,
+
+    VIRTIO_GPU_BLOB_FLAG_USE_MAPPABLE     = 0x0001,
+    VIRTIO_GPU_BLOB_FLAG_USE_SHAREABLE    = 0x0002,
+    VIRTIO_GPU_BLOB_FLAG_USE_CROSS_DEVICE = 0x0004,
+
+    VIRTIO_GPU_MAP_CACHE_NONE    = 0x0000,
+    VIRTIO_GPU_MAP_CACHE_CACHED  = 0x0001,
+    VIRTIO_GPU_MAP_CACHE_UNCACHED = 0x0002,
+    VIRTIO_GPU_MAP_CACHE_WC      = 0x0003,
+};
+
+#define VIRTIO_GPU_F_BLOB_ALIGNMENT 5
+
+#define VIRTIO_GPU_FLAG_FENCE        0x01
+#define VIRTIO_GPU_FLAG_INFO_RING_IDX 0x02
+
+/* Virtio shared-memory region id for the host-visible (blob) window */
+#define VIRTIO_GPU_SHM_ID_HOST_VISIBLE 1
+
+#define VIRTIO_GPU_MAX_SCANOUTS  16
+#define VIRTIO_GPU_MAX_RESOURCE_SIZE (64u << 20)
+#define VIRTIO_GPU_MAX_IOVECS     512
+#define VIRTIO_GPU_MAX_CAPSET_SIZE (256u * 1024u)
+
+/*
+ * virtio-gpu pixel formats (subset we can scan out or store)
+ */
+enum {
+    VIRTIO_GPU_FORMAT_B8G8R8A8_UNORM = 1,
+    VIRTIO_GPU_FORMAT_B8G8R8X8_UNORM = 2,
+    VIRTIO_GPU_FORMAT_A8R8G8B8_UNORM = 3,
+    VIRTIO_GPU_FORMAT_X8R8G8B8_UNORM = 4,
+};
+
+typedef struct __attribute__((packed)) {
+    uint64_t addr;
+    uint32_t len;
+    uint16_t flags;
+    uint16_t next;
+} virtq_desc_t;
+
+typedef struct __attribute__((packed)) {
+    uint16_t flags;
+    uint16_t idx;
+} virtq_avail_t;
+
+typedef struct __attribute__((packed)) {
+    uint32_t len;
+    uint32_t flags;
+} virtq_used_elem_t;
+
+typedef struct {
+    uint16_t num;
+    uint8_t  ready;
+    uint16_t last_avail_idx;
+    uint16_t used_idx;
+    uint64_t desc_addr;
+    uint64_t avail_addr;
+    uint64_t used_addr;
+} virtio_queue_t;
+
+typedef struct __attribute__((packed)) {
+    uint32_t type;
+    uint32_t flags;
+    uint64_t fence_id;
+    uint32_t ctx_id;
+    uint16_t ring_idx;
+    uint16_t padding;
+} virtio_gpu_hdr_t;
+
+typedef struct __attribute__((packed)) {
+    uint32_t x;
+    uint32_t y;
+    uint32_t width;
+    uint32_t height;
+} virtio_gpu_rect_t;
+
+typedef struct __attribute__((packed)) {
+    virtio_gpu_rect_t r;
+    uint32_t enabled;
+    uint32_t flags;
+} virtio_gpu_mode_t;
+
+typedef struct __attribute__((packed)) {
+    uint64_t addr;
+    uint32_t length;
+    uint32_t space;
+} virtio_gpu_mem_entry_t;
+
+typedef struct {
+    uint32_t id;
+    bool     used;
+    bool     is_3d;
+    bool     is_cursor;
+    // Blob resources (venus)
+    bool     blob;
+    uint64_t blob_size;
+    void*    blob_map;
+    uint64_t blob_map_size;
+    uint32_t width;
+    uint32_t height;
+    uint32_t bpp;
+    rvvm_rgb_t format;
+    uint8_t* backing;
+    size_t   backing_size;
+    // Guest backing memory (attached iovecs)
+    struct {
+        uint64_t addr;
+        uint32_t len;
+    } iovec[VIRTIO_GPU_MAX_IOVECS];
+    uint32_t iovec_count;
+} virtio_gpu_resource_t;
+
+typedef struct {
+    bool      enabled;
+    uint32_t  x;
+    uint32_t  y;
+    uint32_t  width;
+    uint32_t  height;
+    uint32_t  resource_id;
+} virtio_gpu_scanout_t;
+
+/*
+ * virglrenderer venus backend. libvirglrenderer is dlopen()ed at runtime so
+ * that hosts without a Vulkan driver still get 2D display; on iOS the app
+ * bundles virglrenderer built against MoltenVK (Vulkan-over-Metal).
+ */
+typedef struct iovec vg_iovec_t;
+
+typedef struct {
+    uint32_t handle, target, format, bind;
+    uint32_t width, height, depth, array_size;
+    uint32_t last_level, nr_samples, flags;
+} vg_vr_res_args_t;
+
+typedef struct {
+    uint32_t res_handle, ctx_id, blob_mem, blob_flags;
+    uint64_t blob_id, size;
+    const vg_iovec_t* iovecs;
+    uint32_t num_iovs;
+} vg_vr_blob_args_t;
+
+typedef struct {
+    uint32_t x, y, z, w, h, d;
+} vg_vr_box_t;
+
+/* Subset of struct virgl_renderer_callbacks (version 3 layout) */
+typedef struct {
+    int version;
+    void (*write_fence)(void* cookie, uint32_t fence);
+    void* create_gl_context;
+    void* destroy_gl_context;
+    void* make_current;
+    void* get_drm_fd;
+    void (*write_context_fence)(void* cookie, uint32_t ctx_id, uint32_t ring_idx, uint64_t fence_id);
+    void* get_server_fd;
+    void* get_egl_display;
+} vg_vr_cbs_t;
+
+typedef struct {
+    void* dl;
+    int  (*init)(void* cookie, int flags, vg_vr_cbs_t* cb);
+    void (*cleanup)(void* cookie);
+    void (*poll)(void);
+    void (*get_cap_set)(uint32_t set, uint32_t* max_ver, uint32_t* max_size);
+    void (*fill_caps)(uint32_t set, uint32_t version, void* caps);
+    int  (*context_create_with_flags)(uint32_t ctx_id, uint32_t ctx_flags, uint32_t nlen, const char* name);
+    void (*context_destroy)(uint32_t ctx_id);
+    void (*ctx_attach_resource)(uint32_t ctx_id, uint32_t res_handle);
+    void (*ctx_detach_resource)(uint32_t ctx_id, uint32_t res_handle);
+    int  (*resource_create)(vg_vr_res_args_t* args, vg_iovec_t* iov, uint32_t num_iovs);
+    void (*resource_unref)(uint32_t res_handle);
+    int  (*resource_attach_iov)(uint32_t res_handle, vg_iovec_t* iov, int num_iovs);
+    void (*resource_detach_iov)(uint32_t res_handle, vg_iovec_t** iov, int* num_iovs);
+    int  (*resource_create_blob)(const vg_vr_blob_args_t* args);
+    int  (*resource_map)(uint32_t res_handle, void** map, uint64_t* out_size);
+    int  (*resource_unmap)(uint32_t res_handle);
+    int  (*resource_get_map_info)(uint32_t res_handle, uint32_t* map_info);
+    int  (*resource_get_info)(uint32_t res_handle, void* info);
+    int  (*submit_cmd)(void* buffer, int ctx_id, int ndw);
+    int  (*transfer_read_iov)(uint32_t handle, uint32_t ctx_id, uint32_t level, uint32_t stride,
+                              uint32_t layer_stride, vg_vr_box_t* box, uint64_t offset, vg_iovec_t* iov,
+                              int iovec_cnt);
+    int  (*transfer_write_iov)(uint32_t handle, uint32_t ctx_id, int level, uint32_t stride,
+                               uint32_t layer_stride, vg_vr_box_t* box, uint64_t offset, vg_iovec_t* iovec,
+                               unsigned int iovec_cnt);
+    int  (*create_fence)(int client_fence_id, uint32_t ctx_id);
+    int  (*context_create_fence)(uint32_t ctx_id, uint32_t flags, uint32_t ring_idx, uint64_t fence_id);
+    void (*force_ctx_0)(void);
+    void (*reset)(void);
+} vg_venus_api_t;
+
+/* Response held back until its GPU fence signals */
+typedef struct {
+    uint16_t head;
+    uint32_t total_len;
+    uint32_t in_count;  // device-readable (guest -> device)
+    uint32_t out_count; // device-writable (device -> guest)
+    struct {
+        uint64_t addr;
+        uint32_t len;
+        uint8_t  write;
+    } seg[128];
+} virtq_chain_t;
+
+typedef struct {
+    bool used;
+    bool ctx_fence;
+    virtio_queue_t* q;
+    virtq_chain_t chain;
+    uint8_t resp[128];
+    size_t resp_len;
+    uint64_t fence_id;
+    uint32_t fence_key;
+    uint32_t ctx_id;
+    uint32_t ring_idx;
+    int used_i;  // atomic mirror of used (fence callbacks are lock-free)
+    int done_i;
+} vg_pending_resp_t;
+
+typedef struct {
+    rvvm_machine_t* machine;
+    rvvm_intc_t*    intc;
+    rvvm_irq_t      irq;
+
+    rvvm_fbdev_t*   fbdev;
+    bool            owns_fbdev_ref;
+    void*           vram;
+    size_t          vram_size;
+    bool            owns_vram;
+    uint32_t        disp_width;
+    uint32_t        disp_height;
+
+    spinlock_t lock;
+
+    // Command processing buffers (allocated at init)
+    uint8_t* req_buf;
+    uint8_t* resp_buf;
+    size_t   buf_cap;
+
+    uint32_t host_features[2];
+    uint32_t driver_features[2];
+    uint32_t host_features_sel;
+    uint32_t driver_features_sel;
+
+    uint32_t status;
+    uint32_t interrupt_status;
+    uint32_t queue_sel;
+    uint32_t config_generation;
+
+    virtio_queue_t q[2];
+
+    virtio_gpu_resource_t resources[64];
+    virtio_gpu_scanout_t   scanout[VIRTIO_GPU_MAX_SCANOUTS];
+    virtio_gpu_cursor_info_t cursor;
+    uint64_t fence_seq;
+
+    // Venus 3D backend (virglrenderer) state
+    vg_venus_api_t* venus;
+    uint32_t num_capsets;
+    uint32_t capset_ids[8];
+    uint32_t capset_max_ver[8];
+    uint32_t capset_max_size[8];
+
+    // Host-visible blob window (virtio SHM region VIRTIO_GPU_SHM_ID_HOST_VISIBLE)
+    rvvm_addr_t win_base;
+    size_t      win_size;
+    uint32_t    shm_sel;
+
+    // Deferred fence responses
+    vg_pending_resp_t pending[64];
+    uint32_t fence_key_seq;
+
+    // Current command context (set by the queue pump for fence deferral)
+    virtio_queue_t* cur_q;
+    virtq_chain_t*  cur_chain;
+    uint32_t        stop_poller;
+    void*           poller_thread;
+} virtio_gpu_dev_t;
+
+static void vg_venus_window_detach(virtio_gpu_dev_t* vg, virtio_gpu_resource_t* res);
+static void vg_venus_poll(virtio_gpu_dev_t* vg);
+
+/*
+ * Virtqueue helpers
+ */
+
+static void* virtio_gpu_dma_ptr(virtio_gpu_dev_t* vg, uint64_t addr, size_t len)
+{
+    return rvvm_get_dma_ptr(vg->machine, (rvvm_addr_t)addr, len);
+}
+
+static uint32_t mmio_load_u32(const void* data, uint8_t size)
+{
+    if (size == 1) {
+        return read_uint8(data);
+    }
+    if (size == 2) {
+        return read_uint16_le(data);
+    }
+    return read_uint32_le(data);
+}
+
+static void mmio_store_u32(void* data, uint32_t val, uint8_t size)
+{
+    if (size == 1) {
+        write_uint8(data, (uint8_t)val);
+    } else if (size == 2) {
+        write_uint16_le(data, (uint16_t)val);
+    } else {
+        write_uint32_le(data, val);
+    }
+}
+
+static bool virtq_load_desc(virtio_gpu_dev_t* vg, uint64_t table_addr, uint32_t table_entries, uint16_t idx,
+                            virtq_desc_t* out)
+{
+    if (!out || table_addr == 0 || table_entries == 0 || idx >= table_entries) {
+        return false;
+    }
+    uint8_t* p = virtio_gpu_dma_ptr(vg, table_addr + (uint64_t)idx * sizeof(virtq_desc_t), sizeof(virtq_desc_t));
+    if (!p) {
+        return false;
+    }
+    out->addr  = read_uint64_le(p + 0);
+    out->len   = read_uint32_le(p + 8);
+    out->flags = read_uint16_le(p + 12);
+    out->next  = read_uint16_le(p + 14);
+    return true;
+}
+
+static bool virtq_collect_descs(virtio_gpu_dev_t* vg, uint64_t table_addr, uint32_t table_entries, uint16_t head,
+                                virtq_chain_t* chain)
+{
+    virtq_desc_t d;
+    uint16_t idx = head;
+    for (uint32_t hops = 0; hops < table_entries + 8; ++hops) {
+        if (!virtq_load_desc(vg, table_addr, table_entries, idx, &d)) {
+            return false;
+        }
+        if (chain->in_count + chain->out_count >= STATIC_ARRAY_SIZE(chain->seg)) {
+            return false;
+        }
+        uint32_t si = chain->in_count + chain->out_count;
+        chain->seg[si].addr  = d.addr;
+        chain->seg[si].len   = d.len;
+        chain->seg[si].write = (d.flags & VIRTQ_DESC_F_WRITE) ? 1 : 0;
+        chain->total_len += d.len;
+        if (chain->seg[si].write) {
+            chain->out_count++;
+        } else {
+            chain->in_count++;
+        }
+
+        if (d.flags & VIRTQ_DESC_F_INDIRECT) {
+            uint32_t entries = d.len / (uint32_t)sizeof(virtq_desc_t);
+            if (entries == 0 || entries > 4096) {
+                return false;
+            }
+            if (!virtq_collect_descs(vg, d.addr, entries, 0, chain)) {
+                return false;
+            }
+            return true;
+        }
+
+        if (!(d.flags & VIRTQ_DESC_F_NEXT)) {
+            return true;
+        }
+        idx = d.next;
+    }
+    return false;
+}
+
+static bool virtq_collect_chain(virtio_gpu_dev_t* vg, virtio_queue_t* q, uint16_t head, virtq_chain_t* chain)
+{
+    if (!q || !chain || q->num == 0) {
+        return false;
+    }
+    memset(chain, 0, sizeof(*chain));
+    chain->head = head;
+    return virtq_collect_descs(vg, q->desc_addr, q->num, head, chain);
+}
+
+
+/*
+ * Chain I/O: treat readable segs as a linear request buffer,
+ * writable segs as a linear response buffer.
+ */
+static size_t virtq_chain_read(virtio_gpu_dev_t* vg, const virtq_chain_t* chain, size_t off, void* buf, size_t len)
+{
+    uint8_t* out = buf;
+    size_t done = 0;
+    size_t pos = 0;
+    for (uint32_t i = 0; i < chain->in_count + chain->out_count && done < len; ++i) {
+        if (chain->seg[i].write) {
+            continue;
+        }
+        if (pos + chain->seg[i].len <= off) {
+            pos += chain->seg[i].len;
+            continue;
+        }
+        size_t seg_off = (pos > off) ? 0 : (off - pos);
+        size_t take = chain->seg[i].len - seg_off;
+        if (take > len - done) {
+            take = len - done;
+        }
+        const uint8_t* src = virtio_gpu_dma_ptr(vg, chain->seg[i].addr + seg_off, take);
+        if (!src) {
+            break;
+        }
+        memcpy(out + done, src, take);
+        done += take;
+        pos += chain->seg[i].len;
+    }
+    return done;
+}
+
+static size_t virtq_chain_write(virtio_gpu_dev_t* vg, const virtq_chain_t* chain, size_t off, const void* buf,
+                                size_t len)
+{
+    const uint8_t* in = buf;
+    size_t done = 0;
+    size_t pos = 0;
+    for (uint32_t i = 0; i < chain->in_count + chain->out_count && done < len; ++i) {
+        if (!chain->seg[i].write) {
+            continue;
+        }
+        if (pos + chain->seg[i].len <= off) {
+            pos += chain->seg[i].len;
+            continue;
+        }
+        size_t seg_off = (pos > off) ? 0 : (off - pos);
+        size_t take = chain->seg[i].len - seg_off;
+        if (take > len - done) {
+            take = len - done;
+        }
+        uint8_t* dst = virtio_gpu_dma_ptr(vg, chain->seg[i].addr + seg_off, take);
+        if (!dst) {
+            break;
+        }
+        memcpy(dst, in + done, take);
+        done += take;
+        pos += chain->seg[i].len;
+    }
+    return done;
+}
+
+static void virtq_push_used(virtio_gpu_dev_t* vg, virtio_queue_t* q, uint16_t head, uint32_t len)
+{
+    if (!vg || !q || q->used_addr == 0 || q->num == 0) {
+        return;
+    }
+    uint8_t* used_p = virtio_gpu_dma_ptr(vg, q->used_addr, 4 + (size_t)q->num * sizeof(virtq_used_elem_t));
+    if (!used_p) {
+        return;
+    }
+    uint16_t used_idx = q->used_idx;
+    uint32_t slot = (uint32_t)(used_idx % q->num);
+    size_t elem_off = 4 + (size_t)slot * sizeof(virtq_used_elem_t);
+    write_uint32_le(used_p + elem_off + 0, head);
+    write_uint32_le(used_p + elem_off + 4, len);
+    used_idx++;
+    q->used_idx = used_idx;
+    write_uint16_le(used_p + 2, used_idx);
+
+    vg->interrupt_status |= 1;
+    rvvm_raise_irq(vg->intc, vg->irq);
+}
+
+/*
+ * Resources
+ */
+
+static virtio_gpu_resource_t* vg_resource_find(virtio_gpu_dev_t* vg, uint32_t id)
+{
+    if (id == 0) {
+        return NULL;
+    }
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->resources); ++i) {
+        if (vg->resources[i].used && vg->resources[i].id == id) {
+            return &vg->resources[i];
+        }
+    }
+    return NULL;
+}
+
+static virtio_gpu_resource_t* vg_resource_alloc(virtio_gpu_dev_t* vg, uint32_t id)
+{
+    if (id == 0 || vg_resource_find(vg, id)) {
+        return NULL;
+    }
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->resources); ++i) {
+        if (!vg->resources[i].used) {
+            memset(&vg->resources[i], 0, sizeof(vg->resources[i]));
+            vg->resources[i].id = id;
+            vg->resources[i].used = true;
+            return &vg->resources[i];
+        }
+    }
+    return NULL;
+}
+
+static void vg_resource_unref(virtio_gpu_dev_t* vg, virtio_gpu_resource_t* res)
+{
+    if (!res) {
+        return;
+    }
+    if (vg->venus && res->is_3d) {
+        if (res->blob) {
+            vg_venus_window_detach(vg, res);
+            vg->venus->resource_unmap(res->id);
+        } else {
+            vg_iovec_t* iov = NULL;
+            int cnt = 0;
+            vg->venus->resource_detach_iov(res->id, &iov, &cnt);
+        }
+        vg->venus->resource_unref(res->id);
+    } else {
+        UNUSED(vg);
+    }
+    if (res->backing) {
+        free(res->backing);
+    }
+    res->backing = NULL;
+    res->backing_size = 0;
+    res->used = false;
+}
+
+static uint32_t vg_virtio_format_to_rvvm(uint32_t fmt, bool* ok)
+{
+    *ok = true;
+    switch (fmt) {
+        case VIRTIO_GPU_FORMAT_B8G8R8A8_UNORM: return RVVM_RGB_XRGB8888 | RVVM_RGB_ALPHA_MASK;
+        case VIRTIO_GPU_FORMAT_B8G8R8X8_UNORM: return RVVM_RGB_XRGB8888;
+        case VIRTIO_GPU_FORMAT_A8R8G8B8_UNORM: return RVVM_RGB_XBGR8888 | RVVM_RGB_ALPHA_MASK;
+        case VIRTIO_GPU_FORMAT_X8R8G8B8_UNORM: return RVVM_RGB_XBGR8888;
+        default: *ok = false; return RVVM_RGB_INVALID;
+    }
+}
+
+/*
+ * Guest backing memory access (attached iovecs form a linear buffer)
+ */
+static bool vg_guest_read(virtio_gpu_dev_t* vg, virtio_gpu_resource_t* res, uint64_t off, void* buf, size_t len)
+{
+    uint8_t* out = buf;
+    size_t done = 0;
+    uint64_t pos = 0;
+    for (uint32_t i = 0; i < res->iovec_count && done < len; ++i) {
+        if (pos + res->iovec[i].len <= off) {
+            pos += res->iovec[i].len;
+            continue;
+        }
+        size_t seg_off = (size_t)((pos > off) ? 0 : (off - pos));
+        size_t take = res->iovec[i].len - seg_off;
+        if (take > len - done) {
+            take = len - done;
+        }
+        const uint8_t* src = virtio_gpu_dma_ptr(vg, res->iovec[i].addr + seg_off, take);
+        if (!src) {
+            return false;
+        }
+        memcpy(out + done, src, take);
+        done += take;
+        pos += res->iovec[i].len;
+    }
+    return done == len;
+}
+
+static size_t vg_guest_size(const virtio_gpu_resource_t* res)
+{
+    size_t size = 0;
+    for (uint32_t i = 0; i < res->iovec_count; ++i) {
+        size += res->iovec[i].len;
+    }
+    return size;
+}
+
+/*
+ * Scanout: blit resource into VRAM (format-converted), mark dirty.
+ * The fbdev scanout is a view into VRAM sized to the guest scanout rect.
+ */
+static void vg_scanout_blit(virtio_gpu_dev_t* vg, const virtio_gpu_rect_t* rect)
+{
+    virtio_gpu_scanout_t* scan = &vg->scanout[0];
+    if (!scan->enabled || scan->resource_id == 0) {
+        return;
+    }
+    virtio_gpu_resource_t* res = vg_resource_find(vg, scan->resource_id);
+    if (!res || res->bpp != 32 || res->width == 0 || res->height == 0 || !res->backing) {
+        return;
+    }
+
+    uint8_t* vram = vg->vram;
+    uint32_t dst_w = scan->width;
+    uint32_t dst_h = scan->height;
+    if (!vram || dst_w == 0 || dst_h == 0) {
+        return;
+    }
+    if ((size_t)dst_w * dst_h * 4 > vg->vram_size) {
+        return;
+    }
+
+    // Clip the dirty rect to both the resource and the scanout
+    uint32_t x0 = rect->x;
+    uint32_t y0 = rect->y;
+    uint32_t x1 = rect->x + rect->width;
+    uint32_t y1 = rect->y + rect->height;
+    if (x0 < scan->x) x0 = scan->x;
+    if (y0 < scan->y) y0 = scan->y;
+    if (x1 > scan->x + scan->width) x1 = scan->x + scan->width;
+    if (y1 > scan->y + scan->height) y1 = scan->y + scan->height;
+    if (x0 >= x1 || y0 >= y1) {
+        return;
+    }
+
+    // Source rect in resource coords
+    uint32_t sx = x0 - scan->x;
+    uint32_t sy = y0 - scan->y;
+
+    // Strides: resource and VRAM scanout (both 32bpp)
+    size_t src_stride = (size_t)res->width * 4;
+    size_t dst_stride = (size_t)dst_w * 4;
+
+    const uint8_t* src = res->backing;
+    uint8_t* dst = vram;
+
+    // VRAM pixel format is XRGB8888 (a8r8g8b8, memory {B,G,R,X})
+    bool same_fmt = (res->format & 0x0F) == 4 && !(res->format & (RVVM_RGB_SWAP_R_B | RVVM_RGB_BIG_ENDIAN));
+    bool swap_rb = (res->format & RVVM_RGB_SWAP_R_B) != 0;
+
+    for (uint32_t y = y0; y < y1; ++y) {
+        const uint8_t* s = src + (size_t)(sy + (y - y0)) * src_stride + (size_t)sx * 4;
+        uint8_t* d = dst + (size_t)y * dst_stride + (size_t)x0 * 4;
+        if (same_fmt) {
+            memcpy(d, s, (size_t)(x1 - x0) * 4);
+        } else {
+            for (uint32_t x = 0; x < (x1 - x0); ++x) {
+                if (swap_rb) {
+                    // Source {R,G,B,X} -> dest {B,G,R,X}
+                    d[x * 4 + 0] = s[x * 4 + 2];
+                    d[x * 4 + 1] = s[x * 4 + 1];
+                    d[x * 4 + 2] = s[x * 4 + 0];
+                } else {
+                    d[x * 4 + 0] = s[x * 4 + 0];
+                    d[x * 4 + 1] = s[x * 4 + 1];
+                    d[x * 4 + 2] = s[x * 4 + 2];
+                }
+                d[x * 4 + 3] = 0xFF;
+            }
+        }
+    }
+
+    rvvm_fbdev_dirty(vg->fbdev);
+    rvvm_fbdev_update(vg->fbdev);
+}
+
+/*
+ * Apply the current scanout mode to the fbdev
+ */
+static void vg_scanout_apply(virtio_gpu_dev_t* vg)
+{
+    virtio_gpu_scanout_t* scan = &vg->scanout[0];
+    if (!vg->fbdev || !vg->vram) {
+        return;
+    }
+    if (scan->enabled && scan->width > 0 && scan->height > 0
+        && (size_t)scan->width * scan->height * 4 <= vg->vram_size) {
+        rvvm_fb_t fb = {
+            .buffer = vg->vram,
+            .width = scan->width,
+            .height = scan->height,
+            .stride = 0,
+            .format = RVVM_RGB_XRGB8888,
+        };
+        rvvm_fbdev_set_scanout(vg->fbdev, &fb);
+    } else {
+        // Disabled scanout: show a blank mode of the default size
+        rvvm_fb_t fb = {
+            .buffer = vg->vram,
+            .width = vg->disp_width,
+            .height = vg->disp_height,
+            .stride = 0,
+            .format = RVVM_RGB_XRGB8888,
+        };
+        if ((size_t)fb.width * fb.height * 4 <= vg->vram_size) {
+            rvvm_fbdev_set_scanout(vg->fbdev, &fb);
+        }
+    }
+    rvvm_fbdev_dirty(vg->fbdev);
+    rvvm_fbdev_update(vg->fbdev);
+}
+
+/*
+ * EDID generation: 128-byte block describing our single fixed mode
+ */
+static void vg_build_edid(virtio_gpu_dev_t* vg, uint8_t* edid)
+{
+    memset(edid, 0, 128);
+    uint32_t h = vg->disp_width;
+    uint32_t v = vg->disp_height;
+
+    // Header
+    edid[0] = 0x00; edid[1] = 0xFF; edid[2] = 0xFF; edid[3] = 0xFF;
+    edid[4] = 0xFF; edid[5] = 0xFF; edid[6] = 0xFF; edid[7] = 0x00;
+
+    // Manufacturer ID "RVV" (3 letters compressed into 2 bytes)
+    edid[8]  = 0x46; // R=10001, V=10101 -> 0100 0110
+    edid[9]  = 0xB5; // V=10101 -> 1011 0101
+    edid[10] = 0x00; // product code lo
+    edid[11] = 0x00; // product code hi
+    edid[12] = 0x00; // serial
+    edid[13] = 0x00;
+    edid[14] = 0x00;
+    edid[15] = 0x00;
+    edid[16] = 0x01; // week
+    edid[17] = 0x20; // year (2020+)
+    edid[18] = 0x01; // EDID version
+    edid[19] = 0x04; // revision
+
+    edid[20] = 0xA7; // Video input: digital, 8bpc, DP
+    edid[21] = 0x00; // screen size h
+    edid[22] = 0x00; // screen size v
+    edid[23] = 0x78; // gamma = 120/100 + 1 = 2.2
+    edid[24] = 0xEA; // features: RGB 4:4:4, sRGB, preferred timing
+
+    // Chromaticity (sRGB defaults)
+    static const uint8_t chroma[10] = {
+        0xEE, 0x91, 0xA3, 0x54, 0x4C, 0x99, 0x26, 0x0F, 0x50, 0x54,
+    };
+    memcpy(edid + 25, chroma, sizeof(chroma));
+
+    edid[35] = 0x00; // established timings
+    edid[36] = 0x00;
+    edid[37] = 0x00;
+    edid[38] = 0x00; // standard timings (unused)
+    edid[39] = 0x00;
+    edid[40] = 0x00;
+    edid[41] = 0x00;
+    edid[42] = 0x00;
+    edid[43] = 0x00;
+    edid[44] = 0x00;
+    edid[45] = 0x00;
+    edid[46] = 0x00;
+    edid[47] = 0x00;
+    edid[48] = 0x00;
+    edid[49] = 0x00;
+    edid[50] = 0x00;
+    edid[51] = 0x00;
+    edid[52] = 0x00;
+    edid[53] = 0x00;
+    edid[54] = 0x00;
+
+    // Descriptor 1: detailed timing for our mode (18 bytes at offset 54)
+    // 60Hz, non-interlaced, digital separate sync
+    uint32_t hactive = h;
+    uint32_t vactive = v;
+    uint32_t pixclk_khz = (uint32_t)(((uint64_t)hactive * vactive * 60) / 1000);
+    if (pixclk_khz < 1000) pixclk_khz = 1000;
+    if (pixclk_khz > 0xFFFF * 10) pixclk_khz = 0xFFFF * 10;
+
+    uint32_t hblank = (hactive / 5) & ~1U;
+    uint32_t vblank = (vactive / 20 + 20) & ~1U;
+    uint32_t hsync_w = (hactive / 12) & ~1U;
+    uint32_t vsync_w = 1;
+    uint32_t hfront = (hblank / 3) & ~1U;
+    uint32_t vfront = (vblank / 3) & ~1U;
+
+    uint8_t* dtd = edid + 54;
+    dtd[0] = (pixclk_khz / 10) & 0xFF;
+    dtd[1] = ((pixclk_khz / 10) >> 8) & 0xFF;
+    dtd[2] = hactive & 0xFF;
+    dtd[3] = hblank & 0xFF;
+    dtd[4] = (uint8_t)(((hactive >> 8) & 0x0F) << 4 | ((hblank >> 8) & 0x0F));
+    dtd[5] = vactive & 0xFF;
+    dtd[6] = vblank & 0xFF;
+    dtd[7] = (uint8_t)(((vactive >> 8) & 0x0F) << 4 | ((vblank >> 8) & 0x0F));
+    dtd[8] = hfront & 0xFF;
+    dtd[9] = hsync_w & 0xFF;
+    dtd[10] = (uint8_t)((((hfront >> 8) & 0x0F) << 6) | (((hsync_w >> 8) & 0x0F) << 4) | ((vfront & 0x0F) << 2) | (vsync_w & 0x0F));
+    dtd[11] = 0x00;
+    dtd[12] = 0x1E; // image size h (cm)
+    dtd[13] = 0x00;
+    dtd[14] = 0x0F; // image size v (cm)
+    dtd[15] = 0x00;
+    dtd[16] = 0x00; // h border
+    dtd[17] = 0x00; // v border
+    dtd[18] = 0x1E; // digital, separate sync
+
+    // Descriptor 2: monitor name
+    edid[72 + 3] = 0xFC;
+    const char* name = "RVVM Display";
+    for (size_t i = 0; i < 13 && name[i]; ++i) {
+        edid[72 + 5 + i] = (uint8_t)name[i];
+    }
+    edid[72 + 18] = 0x0A;
+
+    // Descriptor 3: range limits (60Hz fixed mode)
+    edid[90 + 3] = 0xFD;
+    edid[90 + 5] = 50;   // min vrefresh
+    edid[90 + 6] = 60;   // max vrefresh
+    edid[90 + 7] = 30;   // min hsync kHz
+    edid[90 + 8] = 140;  // max hsync kHz
+    edid[90 + 9] = 255;  // max pixel clock /10MHz (2.55GHz)
+    edid[90 + 10] = 0x00; // no extended timing
+    edid[90 + 11] = 0x0A; // LF terminator
+    // Descriptor 4: dummy
+    edid[108 + 0] = 0x00; edid[108 + 1] = 0x00; edid[108 + 2] = 0x00; edid[108 + 3] = 0x10;
+
+    edid[126] = 0x00; // extension count
+    uint8_t sum = 0;
+    for (size_t i = 0; i < 127; ++i) {
+        sum += edid[i];
+    }
+    edid[127] = (uint8_t)(0x100 - sum);
+}
+
+/*
+ * Venus backend bridge: virglrenderer's venus renderer implements the Venus
+ * (Vulkan serialization) protocol that the guest venus driver speaks over
+ * virtio-gpu. On iOS virglrenderer is built against MoltenVK; on other hosts
+ * any Vulkan ICD works (lavapipe, swiftshader, native).
+ *
+ * Fences: the virglrenderer fence callbacks must NEVER take the device lock
+ * (they may fire from inside virglrenderer calls made with the lock held).
+ * They only mark pending entries done (atomic); a poller thread and the
+ * queue pump complete the deferred virtqueue responses.
+ */
+#define VG_RESP_DEFERRED         ((size_t)-1)
+#define VG_VENUS_FLAG_NO_VIRGL   0x1  /* advertise only the venus capset */
+#define VG_VENUS_WINDOW_BASE     0x7000000000ULL
+#define VG_VENUS_WINDOW_SIZE     (512u << 20)
+#define VG_VENUS_MAX_PENDING     64
+
+static void vg_pending_mark_done(virtio_gpu_dev_t* vg, uint64_t fence_id, uint32_t fence_key, bool ctx_fence)
+{
+    (void)vg;
+    for (size_t i = 0; i < VG_VENUS_MAX_PENDING; ++i) {
+        vg_pending_resp_t* p = &vg->pending[i];
+        int used = __atomic_load_n(&p->used_i, __ATOMIC_ACQUIRE);
+        if (!used) {
+            continue;
+        }
+        if (ctx_fence && p->ctx_fence && p->fence_id == fence_id) {
+            __atomic_store_n(&p->done_i, 1, __ATOMIC_RELEASE);
+            return;
+        }
+        if (!ctx_fence && !p->ctx_fence && p->fence_key == fence_key) {
+            __atomic_store_n(&p->done_i, 1, __ATOMIC_RELEASE);
+            return;
+        }
+    }
+}
+
+static void vg_venus_write_fence(void* cookie, uint32_t fence)
+{
+    vg_pending_mark_done((virtio_gpu_dev_t*)cookie, 0, fence, false);
+}
+
+static void vg_venus_write_context_fence(void* cookie, uint32_t ctx_id, uint32_t ring_idx, uint64_t fence_id)
+{
+    (void)ctx_id;
+    (void)ring_idx;
+    vg_pending_mark_done((virtio_gpu_dev_t*)cookie, fence_id, 0, true);
+}
+
+/* Complete deferred responses whose fences signaled. Caller holds vg->lock. */
+static void vg_complete_pending_locked(virtio_gpu_dev_t* vg)
+{
+    for (size_t i = 0; i < VG_VENUS_MAX_PENDING; ++i) {
+        vg_pending_resp_t* p = &vg->pending[i];
+        if (!p->used || !__atomic_load_n(&p->done_i, __ATOMIC_ACQUIRE)) {
+            continue;
+        }
+        virtq_chain_write(vg, &p->chain, 0, p->resp, p->resp_len);
+        virtq_push_used(vg, p->q, p->chain.head, (uint32_t)p->resp_len);
+        p->used = false;
+        __atomic_store_n(&p->done_i, 0, __ATOMIC_RELAXED);
+    }
+}
+
+/* Poll virglrenderer + complete fences. Safe without the device lock. */
+void vg_venus_poll(virtio_gpu_dev_t* vg)
+{
+    if (!vg || !vg->venus) {
+        return;
+    }
+    if (vg->venus->poll) {
+        vg->venus->poll();
+    }
+    spin_lock(&vg->lock);
+    vg_complete_pending_locked(vg);
+    spin_unlock(&vg->lock);
+}
+
+static void* vg_venus_poller_thread(void* arg)
+{
+    virtio_gpu_dev_t* vg = (virtio_gpu_dev_t*)arg;
+    while (!__atomic_load_n(&vg->stop_poller, __ATOMIC_ACQUIRE)) {
+        if (vg->venus) {
+            vg_venus_poll(vg);
+        }
+        sleep_ms(1);
+    }
+    return NULL;
+}
+
+static vg_pending_resp_t* vg_pending_alloc(virtio_gpu_dev_t* vg, const void* resp, size_t resp_len, uint64_t fence_id,
+                                           bool ctx_fence, uint32_t fence_key, uint32_t ctx_id, uint32_t ring_idx)
+{
+    for (size_t i = 0; i < VG_VENUS_MAX_PENDING; ++i) {
+        vg_pending_resp_t* p = &vg->pending[i];
+        if (!p->used) {
+            memset(p, 0, sizeof(*p));
+            p->q = vg->cur_q;
+            p->chain = *vg->cur_chain;
+            if (resp_len > sizeof(p->resp)) {
+                resp_len = sizeof(p->resp);
+            }
+            memcpy(p->resp, resp, resp_len);
+            p->resp_len = resp_len;
+            p->fence_id = fence_id;
+            p->fence_key = fence_key;
+            p->ctx_fence = ctx_fence;
+            p->ctx_id = ctx_id;
+            p->ring_idx = ring_idx;
+            __atomic_store_n(&p->used_i, 1, __ATOMIC_RELEASE);
+            p->used = true;
+            return p;
+        }
+    }
+    return NULL;
+}
+
+/*
+ * Host-visible blob window: the guest kernel allocates an offset inside the
+ * virtio SHM region (VIRTIO_GPU_SHM_ID_HOST_VISIBLE) and asks us to map the
+ * blob there. We attach per-blob RAM-like MMIO subregions (direct host
+ * pointer = virglrenderer's mapping) at win_base + offset.
+ */
+typedef struct {
+    bool used;
+    rvvm_mmio_dev_t* mmio;
+    rvvm_addr_t addr;
+    size_t size;
+    uint32_t resource_id;
+} vg_window_slot_t;
+
+static vg_window_slot_t s_window_slots[VG_VENUS_MAX_PENDING];
+
+static bool vg_venus_window_attach(virtio_gpu_dev_t* vg, virtio_gpu_resource_t* res, uint64_t offset, void* map,
+                                   uint64_t map_size)
+{
+    if (!vg->win_base || map_size == 0) {
+        return false;
+    }
+    uint64_t off = offset & ~0xFFFULL;
+    uint64_t size = (map_size + 0xFFFU) & ~0xFFFULL;
+    if (off + size > vg->win_size) {
+        rvvm_warn("virtio-gpu: blob map offset %#.8llx+%#llx outside SHM window", (unsigned long long)off,
+                  (unsigned long long)size);
+        return false;
+    }
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(s_window_slots); ++i) {
+        if (s_window_slots[i].used && s_window_slots[i].resource_id == res->id) {
+            vg_venus_window_detach(vg, res);
+            break;
+        }
+    }
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(s_window_slots); ++i) {
+        if (!s_window_slots[i].used) {
+            static const rvvm_mmio_type_t blob_type = { .name = "virtio_gpu_blob" };
+            rvvm_mmio_dev_t desc = {
+                .addr = vg->win_base + off,
+                .size = (size_t)size,
+                .mapping = map,
+                .type = &blob_type,
+            };
+            rvvm_mmio_dev_t* mmio = rvvm_attach_mmio(vg->machine, &desc);
+            if (!mmio) {
+                return false;
+            }
+            s_window_slots[i].used = true;
+            s_window_slots[i].mmio = mmio;
+            s_window_slots[i].addr = vg->win_base + off;
+            s_window_slots[i].size = (size_t)size;
+            s_window_slots[i].resource_id = res->id;
+            res->blob_map = map;
+            res->blob_map_size = map_size;
+            return true;
+        }
+    }
+    return false;
+}
+
+void vg_venus_window_detach(virtio_gpu_dev_t* vg, virtio_gpu_resource_t* res)
+{
+    (void)vg;
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(s_window_slots); ++i) {
+        if (s_window_slots[i].used && s_window_slots[i].resource_id == res->id) {
+            rvvm_remove_mmio(s_window_slots[i].mmio);
+            s_window_slots[i].used = false;
+            break;
+        }
+    }
+    res->blob_map = NULL;
+    res->blob_map_size = 0;
+}
+
+#define VG_DLSYM(field, name)                                                                                          \
+    do {                                                                                                               \
+        *(void**)&api->field = dlsym(dl, name);                                                                        \
+        if (!api->field) {                                                                                             \
+            rvvm_warn("virtio-gpu: virglrenderer missing symbol %s", name);                                            \
+            free(api);                                                                                                 \
+            dlclose(dl);                                                                                               \
+            return false;                                                                                              \
+        }                                                                                                              \
+    } while (0)
+
+static bool vg_venus_load(virtio_gpu_dev_t* vg, const char* libpath, uint32_t flags)
+{
+    const char* candidates[8];
+    size_t n_cand = 0;
+    if (libpath && *libpath) {
+        candidates[n_cand++] = libpath;
+    }
+    const char* env = getenv("RVVM_VIRGLRENDERER");
+    if (env && *env) {
+        candidates[n_cand++] = env;
+    }
+    candidates[n_cand++] = "libvirglrenderer.so.1";
+    candidates[n_cand++] = "libvirglrenderer.so";
+    candidates[n_cand++] = "libvirglrenderer.1.dylib";
+    candidates[n_cand++] = "libvirglrenderer.dylib";
+
+    void* dl = NULL;
+    for (size_t i = 0; i < n_cand; ++i) {
+        dl = dlopen(candidates[i], RTLD_NOW | RTLD_LOCAL);
+        if (dl) {
+            break;
+        }
+    }
+    if (!dl) {
+        rvvm_warn("virtio-gpu: virglrenderer library not found (%s)", libpath ? libpath : "auto");
+        return false;
+    }
+
+    vg_venus_api_t* api = calloc(1, sizeof(*api));
+    if (!api) {
+        dlclose(dl);
+        return false;
+    }
+    api->dl = dl;
+    VG_DLSYM(init, "virgl_renderer_init");
+    VG_DLSYM(cleanup, "virgl_renderer_cleanup");
+    VG_DLSYM(poll, "virgl_renderer_poll");
+    VG_DLSYM(get_cap_set, "virgl_renderer_get_cap_set");
+    VG_DLSYM(fill_caps, "virgl_renderer_fill_caps");
+    VG_DLSYM(context_create_with_flags, "virgl_renderer_context_create_with_flags");
+    VG_DLSYM(context_destroy, "virgl_renderer_context_destroy");
+    VG_DLSYM(ctx_attach_resource, "virgl_renderer_ctx_attach_resource");
+    VG_DLSYM(ctx_detach_resource, "virgl_renderer_ctx_detach_resource");
+    VG_DLSYM(resource_create, "virgl_renderer_resource_create");
+    VG_DLSYM(resource_unref, "virgl_renderer_resource_unref");
+    VG_DLSYM(resource_attach_iov, "virgl_renderer_resource_attach_iov");
+    VG_DLSYM(resource_detach_iov, "virgl_renderer_resource_detach_iov");
+    VG_DLSYM(resource_create_blob, "virgl_renderer_resource_create_blob");
+    VG_DLSYM(resource_map, "virgl_renderer_resource_map");
+    VG_DLSYM(resource_unmap, "virgl_renderer_resource_unmap");
+    VG_DLSYM(resource_get_map_info, "virgl_renderer_resource_get_map_info");
+    VG_DLSYM(resource_get_info, "virgl_renderer_resource_get_info");
+    VG_DLSYM(submit_cmd, "virgl_renderer_submit_cmd");
+    VG_DLSYM(transfer_read_iov, "virgl_renderer_transfer_read_iov");
+    VG_DLSYM(transfer_write_iov, "virgl_renderer_transfer_write_iov");
+    VG_DLSYM(create_fence, "virgl_renderer_create_fence");
+    // optional symbols
+    *(void**)&api->context_create_fence = dlsym(dl, "virgl_renderer_context_create_fence");
+    *(void**)&api->force_ctx_0 = dlsym(dl, "virgl_renderer_force_ctx_0");
+    *(void**)&api->reset = dlsym(dl, "virgl_renderer_reset");
+
+    static vg_vr_cbs_t cbs;
+    memset(&cbs, 0, sizeof(cbs));
+    cbs.version = 3;
+    cbs.write_fence = vg_venus_write_fence;
+    cbs.write_context_fence = vg_venus_write_context_fence;
+
+    // Venus renderer over the host Vulkan driver (MoltenVK on iOS)
+    int init_flags = (1 << 6) /* VIRGL_RENDERER_VENUS */ | (1 << 1) /* THREAD_SYNC */;
+    if (api->context_create_fence) {
+        init_flags |= (1 << 8) /* ASYNC_FENCE_CB */;
+    }
+    if (flags & VG_VENUS_FLAG_NO_VIRGL) {
+        init_flags |= (1 << 7) /* NO_VIRGL */;
+    }
+    if (api->init(vg, init_flags, &cbs) != 0) {
+        rvvm_warn("virtio-gpu: virgl_renderer_init failed");
+        free(api);
+        dlclose(dl);
+        return false;
+    }
+
+    // Enumerate capsets like UTM's virtio-gpu: virgl, virgl2 (if present) and
+    // venus (if present). The guest venus driver picks VENUS.
+    static const uint32_t probe_ids[] = { VG_VENUS_CAPSET_VIRGL, VG_VENUS_CAPSET_VIRGL2, VG_VENUS_CAPSET_VENUS };
+    vg->num_capsets = 0;
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(probe_ids); ++i) {
+        uint32_t ver = 0, size = 0;
+        api->get_cap_set(probe_ids[i], &ver, &size);
+        if (size == 0) {
+            continue;
+        }
+        if ((flags & VG_VENUS_FLAG_NO_VIRGL) && probe_ids[i] != VG_VENUS_CAPSET_VENUS) {
+            continue;
+        }
+        if (vg->num_capsets >= STATIC_ARRAY_SIZE(vg->capset_ids)) {
+            break;
+        }
+        vg->capset_ids[vg->num_capsets] = probe_ids[i];
+        vg->capset_max_ver[vg->num_capsets] = ver;
+        vg->capset_max_size[vg->num_capsets] = size;
+        vg->num_capsets++;
+    }
+    if (vg->num_capsets == 0) {
+        rvvm_warn("virtio-gpu: virglrenderer reports no usable capsets");
+        api->cleanup(vg);
+        free(api);
+        dlclose(dl);
+        return false;
+    }
+
+    vg->venus = api;
+    // Advertise 3D + blob resources + context_init to the guest
+    vg->host_features[0] |= 1U << VIRTIO_GPU_F_VIRGL;
+    vg->host_features[0] |= 1U << VIRTIO_GPU_F_RESOURCE_BLOB;
+    vg->host_features[0] |= 1U << VIRTIO_GPU_F_CONTEXT_INIT;
+    {
+        bool has_venus = false;
+        for (uint32_t i = 0; i < vg->num_capsets; ++i) {
+            has_venus = has_venus || (vg->capset_ids[i] == VG_VENUS_CAPSET_VENUS);
+        }
+        rvvm_info("virtio-gpu: venus backend active (capsets:%u venus:%d)", vg->num_capsets, (int)has_venus);
+    }
+    return true;
+}
+
+static void vg_venus_unload(virtio_gpu_dev_t* vg)
+{
+    if (!vg->venus) {
+        return;
+    }
+    __atomic_store_n(&vg->stop_poller, 1, __ATOMIC_RELEASE);
+    if (vg->poller_thread) {
+        rvvm_thread_join((rvvm_thread_t*)vg->poller_thread);
+        vg->poller_thread = NULL;
+    }
+    for (size_t i = 0; i < VG_VENUS_MAX_PENDING; ++i) {
+        if (vg->pending[i].used) {
+            vg->pending[i].used = false;
+        }
+    }
+    if (vg->venus->cleanup) {
+        vg->venus->cleanup(vg);
+    }
+    dlclose(vg->venus->dl);
+    free(vg->venus);
+    vg->venus = NULL;
+    vg->num_capsets = 0;
+}
+
+/*
+ * Command responses
+ */
+
+typedef struct {
+    uint8_t* data;
+    size_t len;
+    size_t cap;
+} vg_resp_buf_t;
+
+static void vg_resp_init(vg_resp_buf_t* b, uint8_t* data, size_t cap)
+{
+    b->data = data;
+    b->cap = cap;
+    b->len = 0;
+}
+
+static void vg_resp_put(vg_resp_buf_t* b, const void* data, size_t len)
+{
+    if (b->len + len > b->cap) {
+        return;
+    }
+    memcpy(b->data + b->len, data, len);
+    b->len += len;
+}
+
+static void vg_resp_hdr(vg_resp_buf_t* b, uint32_t type, const virtio_gpu_hdr_t* req)
+{
+    virtio_gpu_hdr_t hdr = {
+        .type = type,
+        .flags = 0,
+        .fence_id = req ? req->fence_id : 0,
+        .ctx_id = 0,
+        .padding = 0,
+    };
+    vg_resp_put(b, &hdr, sizeof(hdr));
+}
+
+/*
+ * Control queue command processing. Returns response length.
+ */
+static size_t vg_handle_ctrl(virtio_gpu_dev_t* vg, const uint8_t* req, size_t req_len, vg_resp_buf_t* resp)
+{
+    if (req_len < sizeof(virtio_gpu_hdr_t)) {
+        return 0;
+    }
+
+    virtio_gpu_hdr_t hdr;
+    memcpy(&hdr, req, sizeof(hdr));
+
+    switch (hdr.type) {
+        case VIRTIO_GPU_CMD_GET_DISPLAY_INFO: {
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_DISPLAY_INFO, &hdr);
+            for (uint32_t i = 0; i < VIRTIO_GPU_MAX_SCANOUTS; ++i) {
+                virtio_gpu_mode_t mode = {0};
+                if (i == 0) {
+                    mode.r.x = 0;
+                    mode.r.y = 0;
+                    mode.r.width = vg->disp_width;
+                    mode.r.height = vg->disp_height;
+                    mode.enabled = 1;
+                    mode.flags = 0;
+                }
+                vg_resp_put(resp, &mode, sizeof(mode));
+            }
+            return resp->len;
+        }
+        case VIRTIO_GPU_CMD_RESOURCE_CREATE_2D: {
+            struct {
+                uint32_t resource_id;
+                uint32_t format;
+                uint32_t width;
+                uint32_t height;
+            } in;
+            if (req_len < sizeof(hdr) + sizeof(in)) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                return resp->len;
+            }
+            memcpy(&in, req + sizeof(hdr), sizeof(in));
+
+            bool fmt_ok = false;
+            rvvm_rgb_t fmt = vg_virtio_format_to_rvvm(in.format, &fmt_ok);
+            if (!fmt_ok || in.width == 0 || in.height == 0 || in.width > 8192 || in.height > 8192
+                || (uint64_t)in.width * in.height * 4 > VIRTIO_GPU_MAX_RESOURCE_SIZE) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER, &hdr);
+                return resp->len;
+            }
+
+            virtio_gpu_resource_t* res = vg_resource_alloc(vg, in.resource_id);
+            if (!res) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID, &hdr);
+                return resp->len;
+            }
+            res->width = in.width;
+            res->height = in.height;
+            res->format = fmt;
+            res->bpp = 32;
+            res->backing_size = (size_t)in.width * in.height * 4;
+            res->backing = calloc(1, res->backing_size);
+            if (!res->backing) {
+                res->used = false;
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_OUT_OF_MEMORY, &hdr);
+                return resp->len;
+            }
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+            return resp->len;
+        }
+        case VIRTIO_GPU_CMD_RESOURCE_UNREF: {
+            struct {
+                uint32_t resource_id;
+                uint32_t padding;
+            } in;
+            if (req_len < sizeof(hdr) + sizeof(in)) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                return resp->len;
+            }
+            memcpy(&in, req + sizeof(hdr), sizeof(in));
+            virtio_gpu_resource_t* res = vg_resource_find(vg, in.resource_id);
+            if (!res) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID, &hdr);
+                return resp->len;
+            }
+            for (uint32_t i = 0; i < VIRTIO_GPU_MAX_SCANOUTS; ++i) {
+                if (vg->scanout[i].resource_id == in.resource_id) {
+                    vg->scanout[i].resource_id = 0;
+                    vg->scanout[i].enabled = false;
+                }
+            }
+            vg_resource_unref(vg, res);
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+            return resp->len;
+        }
+        case VIRTIO_GPU_CMD_SET_SCANOUT: {
+            struct {
+                virtio_gpu_rect_t r;
+                uint32_t scanout_id;
+                uint32_t resource_id;
+            } in;
+            if (req_len < sizeof(hdr) + sizeof(in)) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                return resp->len;
+            }
+            memcpy(&in, req + sizeof(hdr), sizeof(in));
+
+            if (in.scanout_id >= VIRTIO_GPU_MAX_SCANOUTS || (in.scanout_id != 0)) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID, &hdr);
+                return resp->len;
+            }
+
+            virtio_gpu_scanout_t* scan = &vg->scanout[0];
+            if (in.resource_id == 0) {
+                // Disable scanout
+                scan->enabled = false;
+                scan->resource_id = 0;
+                vg_scanout_apply(vg);
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+                return resp->len;
+            }
+
+            virtio_gpu_resource_t* res = vg_resource_find(vg, in.resource_id);
+            if (!res) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID, &hdr);
+                return resp->len;
+            }
+            if (in.r.x + (uint64_t)in.r.width > res->width || in.r.y + (uint64_t)in.r.height > res->height
+                || in.r.x + (uint64_t)in.r.width > vg->disp_width || in.r.y + (uint64_t)in.r.height > vg->disp_height) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER, &hdr);
+                return resp->len;
+            }
+
+            bool mode_changed = (scan->width != in.r.width) || (scan->height != in.r.height) || !scan->enabled;
+            scan->x = in.r.x;
+            scan->y = in.r.y;
+            scan->width = in.r.width;
+            scan->height = in.r.height;
+            scan->resource_id = in.resource_id;
+            scan->enabled = true;
+            if (mode_changed) {
+                vg_scanout_apply(vg);
+            }
+            // Blit the whole scanout right away
+            {
+                virtio_gpu_rect_t whole = {
+                    .x = in.r.x,
+                    .y = in.r.y,
+                    .width = in.r.width,
+                    .height = in.r.height,
+                };
+                vg_scanout_blit(vg, &whole);
+            }
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+            return resp->len;
+        }
+        case VIRTIO_GPU_CMD_RESOURCE_FLUSH: {
+            struct {
+                virtio_gpu_rect_t r;
+                uint32_t resource_id;
+                uint32_t padding;
+            } in;
+            if (req_len < sizeof(hdr) + sizeof(in)) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                return resp->len;
+            }
+            memcpy(&in, req + sizeof(hdr), sizeof(in));
+            virtio_gpu_resource_t* res = vg_resource_find(vg, in.resource_id);
+            if (!res) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID, &hdr);
+                return resp->len;
+            }
+            if (vg->venus && res->is_3d && res->backing) {
+                // Pull the rendered contents from the venus backend, then blit
+                vg_vr_box_t box = { 0, 0, 0, res->width, res->height, 1 };
+                vg_iovec_t iov = { .iov_base = res->backing, .iov_len = res->backing_size };
+                vg->venus->transfer_read_iov(res->id, hdr.ctx_id, 0, 0, 0, &box, 0, &iov, 1);
+            }
+            if (res->blob && res->blob_map && res->backing) {
+                // Blob scanout: materialize the mapped contents for the blit
+                size_t copy = res->backing_size < res->blob_map_size ? res->backing_size : res->blob_map_size;
+                memcpy(res->backing, res->blob_map, copy);
+            }
+            if (vg->scanout[0].enabled && vg->scanout[0].resource_id == in.resource_id) {
+                vg_scanout_blit(vg, &in.r);
+            }
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+            return resp->len;
+        }
+        case VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D: {
+            struct {
+                virtio_gpu_rect_t r;
+                uint64_t offset;
+                uint32_t resource_id;
+                uint32_t padding;
+            } in;
+            if (req_len < sizeof(hdr) + sizeof(in)) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                return resp->len;
