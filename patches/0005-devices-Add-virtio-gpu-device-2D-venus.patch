+                    uint32_t x, y, z, w, h, d;
+                    uint64_t offset;
+                    uint32_t resource_id;
+                    uint32_t level;
+                    uint32_t stride;
+                    uint32_t layer_stride;
+                } in;
+                if (req_len < sizeof(hdr) + sizeof(in)) {
+                    break;
+                }
+                memcpy(&in, req + sizeof(hdr), sizeof(in));
+                virtio_gpu_resource_t* res = vg_resource_find(vg, in.resource_id);
+                if (res && res->backing) {
+                    vg_vr_box_t box = { in.x, in.y, in.z, in.w, in.h, in.d };
+                    vg_iovec_t iov = { .iov_base = res->backing, .iov_len = res->backing_size };
+                    vg->venus->transfer_read_iov(in.resource_id, hdr.ctx_id, in.level, in.stride, in.layer_stride,
+                                                 &box, in.offset, &iov, 1);
+                }
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+                return resp->len;
+            }
+            case VIRTIO_GPU_CMD_SET_SCANOUT_BLOB: {
+                // struct virtio_gpu_set_scanout_blob {
+                //   hdr; scanout_id; resource_id; rect; offset; format; padding[3]; strides[4]; offsets[4] }
+                struct {
+                    uint32_t scanout_id;
+                    uint32_t resource_id;
+                    virtio_gpu_rect_t r;
+                    uint64_t offset;
+                    uint32_t format;
+                    uint32_t padding[3];
+                    uint32_t strides[4];
+                    uint32_t offsets[4];
+                } in;
+                if (req_len < sizeof(hdr) + sizeof(in)) {
+                    vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                    return resp->len;
+                }
+                memcpy(&in, req + sizeof(hdr), sizeof(in));
+                if (in.scanout_id >= VIRTIO_GPU_MAX_SCANOUTS) {
+                    vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID, &hdr);
+                    return resp->len;
+                }
+                virtio_gpu_resource_t* res = in.resource_id ? vg_resource_find(vg, in.resource_id) : NULL;
+                if (in.resource_id && (!res || !res->blob)) {
+                    vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID, &hdr);
+                    return resp->len;
+                }
+                vg->scanout[in.scanout_id].enabled = (res != NULL);
+                vg->scanout[in.scanout_id].x = in.r.x;
+                vg->scanout[in.scanout_id].y = in.r.y;
+                vg->scanout[in.scanout_id].width = in.r.width;
+                vg->scanout[in.scanout_id].height = in.r.height;
+                vg->scanout[in.scanout_id].resource_id = in.resource_id;
+                if (res && res->blob_map) {
+                    // Blit the mapped blob contents into the display VRAM
+                    uint64_t src_off = in.offset;
+                    size_t row_bytes = (size_t)in.r.width * 4;
+                    for (uint32_t y = 0; y < in.r.height; ++y) {
+                        const uint8_t* src = (const uint8_t*)res->blob_map + src_off + (size_t)y * in.strides[0];
+                        uint8_t* dst = (uint8_t*)vg->vram + ((size_t)(in.r.y + y) * vg->disp_width + in.r.x) * 4;
+                        if ((size_t)(src - (const uint8_t*)res->blob_map) + row_bytes > res->blob_map_size) {
+                            break;
+                        }
+                        if ((size_t)((in.r.y + y) * vg->disp_width + in.r.x) * 4 + row_bytes > vg->vram_size) {
+                            break;
+                        }
+                        memcpy(dst, src, row_bytes);
+                    }
+                    rvvm_fbdev_update(vg->fbdev);
+                }
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+                return resp->len;
+            }
+            case VIRTIO_GPU_CMD_RESOURCE_ASSIGN_UUID: {
+                struct {
+                    uint32_t resource_id;
+                    uint32_t padding;
+                } in;
+                if (req_len < sizeof(hdr) + sizeof(in)) {
+                    vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                    return resp->len;
+                }
+                memcpy(&in, req + sizeof(hdr), sizeof(in));
+                // struct virtio_gpu_resp_resource_uuid { hdr; uuid[16] }
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_RESOURCE_UUID, &hdr);
+                uint8_t uuid[16] = {0};
+                memcpy(uuid, &in.resource_id, 4);
+                vg_resp_put(resp, uuid, 16);
+                return resp->len;
+            }
+            default:
+                break;
+        }
+    }
+
+    vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+    return resp->len;
+}
+
+/*
+ * Cursor queue processing. Returns response length.
+ */
+static size_t vg_handle_cursor(virtio_gpu_dev_t* vg, const uint8_t* req, size_t req_len, vg_resp_buf_t* resp)
+{
+    if (req_len < sizeof(virtio_gpu_hdr_t)) {
+        return 0;
+    }
+    virtio_gpu_hdr_t hdr;
+    memcpy(&hdr, req, sizeof(hdr));
+
+    switch (hdr.type) {
+        case VIRTIO_GPU_CMD_UPDATE_CURSOR: {
+            // struct virtio_gpu_update_cursor {
+            //   hdr; pos{scanout_id,x,y,padding}; resource_id; hot_x; hot_y; padding }
+            struct {
+                uint32_t scanout_id;
+                uint32_t x;
+                uint32_t y;
+                uint32_t padding;
+                uint32_t resource_id;
+                uint32_t hot_x;
+                uint32_t hot_y;
+                uint32_t padding2;
+            } in;
+            if (req_len < sizeof(hdr) + 32) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                return resp->len;
+            }
+            memcpy(&in, req + sizeof(hdr), 32);
+            if (in.scanout_id != 0 && in.scanout_id != 0xFFFFFFFFU) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID, &hdr);
+                return resp->len;
+            }
+            virtio_gpu_resource_t* res = vg_resource_find(vg, in.resource_id);
+            if (in.resource_id != 0) {
+                if (!res) {
+                    vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID, &hdr);
+                    return resp->len;
+                }
+                res->is_cursor = true;
+                vg->cursor.visible = true;
+                vg->cursor.resource_id = in.resource_id;
+                vg->cursor.pos_x = (int32_t)in.x;
+                vg->cursor.pos_y = (int32_t)in.y;
+                vg->cursor.hot_x = in.hot_x;
+                vg->cursor.hot_y = in.hot_y;
+            } else {
+                vg->cursor.visible = false;
+                vg->cursor.resource_id = 0;
+            }
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+            return resp->len;
+        }
+        case VIRTIO_GPU_CMD_MOVE_CURSOR: {
+            struct {
+                uint32_t scanout_id;
+                uint32_t x;
+                uint32_t y;
+                uint32_t padding;
+                uint32_t resource_id;
+            } in;
+            if (req_len < sizeof(hdr) + 20) {
+                vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+                return resp->len;
+            }
+            memcpy(&in, req + sizeof(hdr), 20);
+            vg->cursor.pos_x = (int32_t)in.x;
+            vg->cursor.pos_y = (int32_t)in.y;
+            if (in.resource_id) {
+                vg->cursor.resource_id = in.resource_id;
+                vg->cursor.visible = true;
+            }
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_OK_NODATA, &hdr);
+            return resp->len;
+        }
+        default:
+            vg_resp_hdr(resp, VIRTIO_GPU_RESP_ERR_UNSPEC, &hdr);
+            return resp->len;
+    }
+}
+
+/*
+ * Queue processing
+ */
+static void virtio_gpu_process_queue(virtio_gpu_dev_t* vg, virtio_queue_t* q, bool cursor)
+{
+    if (!vg || !q || !q->ready || q->num == 0) {
+        return;
+    }
+    if (!vg->req_buf || !vg->resp_buf || vg->buf_cap == 0) {
+        return;
+    }
+
+    uint8_t* avail_p = virtio_gpu_dma_ptr(vg, q->avail_addr, 4 + (size_t)q->num * 2);
+    if (!avail_p) {
+        return;
+    }
+
+    // Buffers: requests up to 16K (hdr + 512 iovec entries),
+    // responses up to 16K (EDID 1056 bytes, display info 388 bytes, capsets capped)
+    spin_lock(&vg->lock);
+
+    uint16_t avail_idx = read_uint16_le(avail_p + 2);
+    while (q->last_avail_idx != avail_idx) {
+        uint16_t ring_slot = (uint16_t)(q->last_avail_idx % q->num);
+        uint16_t head = read_uint16_le(avail_p + 4 + (size_t)ring_slot * 2);
+        q->last_avail_idx++;
+
+        virtq_chain_t chain;
+        if (!virtq_collect_chain(vg, q, head, &chain)) {
+            virtq_push_used(vg, q, head, 0);
+            continue;
+        }
+
+        size_t req_len = virtq_chain_read(vg, &chain, 0, vg->req_buf, vg->buf_cap);
+        if (req_len < sizeof(virtio_gpu_hdr_t)) {
+            virtq_push_used(vg, q, head, 0);
+            continue;
+        }
+
+        vg_resp_buf_t resp;
+        vg_resp_init(&resp, vg->resp_buf, vg->buf_cap);
+        virtq_chain_t chain_copy = chain;
+        vg->cur_q = q;
+        vg->cur_chain = &chain_copy;
+        size_t resp_len = cursor ? vg_handle_cursor(vg, vg->req_buf, req_len, &resp)
+                                 : vg_handle_ctrl(vg, vg->req_buf, req_len, &resp);
+        if (resp_len == VG_RESP_DEFERRED) {
+            // Held back until its GPU fence signals (see the venus bridge)
+            continue;
+        }
+        if (resp_len == 0) {
+            virtq_push_used(vg, q, head, 0);
+            continue;
+        }
+
+        size_t w = virtq_chain_write(vg, &chain, 0, vg->resp_buf, resp_len);
+        if (w == 0) {
+            virtq_push_used(vg, q, head, 0);
+            continue;
+        }
+        virtq_push_used(vg, q, head, (uint32_t)w);
+
+        avail_idx = read_uint16_le(avail_p + 2);
+    }
+
+    spin_unlock(&vg->lock);
+}
+
+static void virtio_gpu_reset(virtio_gpu_dev_t* vg)
+{
+    if (!vg) {
+        return;
+    }
+    vg->status = 0;
+    vg->interrupt_status = 0;
+    vg->queue_sel = 0;
+    vg->host_features_sel = 0;
+    vg->driver_features_sel = 0;
+    vg->driver_features[0] = 0;
+    vg->driver_features[1] = 0;
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->q); ++i) {
+        vg->q[i].num = 0;
+        vg->q[i].ready = 0;
+        vg->q[i].last_avail_idx = 0;
+        vg->q[i].used_idx = 0;
+        vg->q[i].desc_addr = 0;
+        vg->q[i].avail_addr = 0;
+        vg->q[i].used_addr = 0;
+    }
+    // Free guest resources
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->resources); ++i) {
+        if (vg->resources[i].used) {
+            vg_resource_unref(vg, &vg->resources[i]);
+        }
+    }
+    memset(vg->scanout, 0, sizeof(vg->scanout));
+    memset(&vg->cursor, 0, sizeof(vg->cursor));
+    vg->config_generation++;
+    rvvm_lower_irq(vg->intc, vg->irq);
+}
+
+/*
+ * MMIO handlers
+ */
+static bool virtio_gpu_mmio_read(rvvm_mmio_dev_t* dev, void* data, size_t offset, uint8_t size)
+{
+    virtio_gpu_dev_t* vg = dev->data;
+    uint32_t val = 0;
+
+    if (offset == VIRTIO_MMIO_SHM_SEL) {
+        val = vg->shm_sel;
+    } else if (offset == VIRTIO_MMIO_SHM_LEN_LOW || offset == VIRTIO_MMIO_SHM_LEN_HIGH) {
+        uint64_t len = (vg->shm_sel == VIRTIO_GPU_SHM_ID_HOST_VISIBLE && vg->win_size)
+                           ? (uint64_t)vg->win_size
+                           : ~(uint64_t)0;
+        val = (uint32_t)(offset == VIRTIO_MMIO_SHM_LEN_LOW ? len : (len >> 32));
+    } else if (offset == VIRTIO_MMIO_SHM_BASE_LOW || offset == VIRTIO_MMIO_SHM_BASE_HIGH) {
+        uint64_t base = (vg->shm_sel == VIRTIO_GPU_SHM_ID_HOST_VISIBLE && vg->win_size)
+                            ? (uint64_t)vg->win_base
+                            : 0;
+        val = (uint32_t)(offset == VIRTIO_MMIO_SHM_BASE_LOW ? base : (base >> 32));
+    } else if (offset >= VIRTIO_MMIO_CONFIG) {
+        // struct virtio_gpu_config {events_read, events_clear, num_scanouts, num_capsets, blob_alignment}
+        switch (offset - VIRTIO_MMIO_CONFIG) {
+            case 0: val = 0; break; // events_read
+            case 4: val = 0; break; // events_clear
+            case 8: val = 1; break; // num_scanouts
+            case 12: val = vg->num_capsets; break; // num_capsets
+            case 16: val = 4096; break; // blob_alignment
+            default: val = 0; break;
+        }
+        mmio_store_u32(data, val, size);
+        return true;
+    }
+
+    switch (offset) {
+        case VIRTIO_MMIO_MAGIC:
+            val = 0x74726976; // "virt"
+            break;
+        case VIRTIO_MMIO_VERSION:
+            val = 2;
+            break;
+        case VIRTIO_MMIO_DEVICE_ID:
+            val = VIRTIO_ID_GPU;
+            break;
+        case VIRTIO_MMIO_VENDOR_ID:
+            val = VIRTIO_MMIO_VENDOR_VALUE;
+            break;
+        case VIRTIO_MMIO_DEVICE_FEATURES:
+            val = vg->host_features[vg->host_features_sel & 1];
+            break;
+        case VIRTIO_MMIO_QUEUE_NUM_MAX:
+            val = 64;
+            break;
+        case VIRTIO_MMIO_QUEUE_NUM:
+            val = vg->q[vg->queue_sel & 1].num;
+            break;
+        case VIRTIO_MMIO_QUEUE_READY:
+            val = vg->q[vg->queue_sel & 1].ready;
+            break;
+        case VIRTIO_MMIO_INTERRUPT_STATUS:
+            val = vg->interrupt_status;
+            break;
+        case VIRTIO_MMIO_STATUS:
+            val = vg->status;
+            break;
+        case VIRTIO_MMIO_QUEUE_DESC_LOW:
+            val = (uint32_t)(vg->q[vg->queue_sel & 1].desc_addr);
+            break;
+        case VIRTIO_MMIO_QUEUE_DESC_HIGH:
+            val = (uint32_t)(vg->q[vg->queue_sel & 1].desc_addr >> 32);
+            break;
+        case VIRTIO_MMIO_QUEUE_AVAIL_LOW:
+            val = (uint32_t)(vg->q[vg->queue_sel & 1].avail_addr);
+            break;
+        case VIRTIO_MMIO_QUEUE_AVAIL_HIGH:
+            val = (uint32_t)(vg->q[vg->queue_sel & 1].avail_addr >> 32);
+            break;
+        case VIRTIO_MMIO_QUEUE_USED_LOW:
+            val = (uint32_t)(vg->q[vg->queue_sel & 1].used_addr);
+            break;
+        case VIRTIO_MMIO_QUEUE_USED_HIGH:
+            val = (uint32_t)(vg->q[vg->queue_sel & 1].used_addr >> 32);
+            break;
+        case VIRTIO_MMIO_CONFIG_GENERATION:
+            val = vg->config_generation;
+            break;
+        default:
+            mmio_store_u32(data, 0, size);
+            return true;
+    }
+
+    mmio_store_u32(data, val, size);
+    return true;
+}
+
+static bool virtio_gpu_mmio_write(rvvm_mmio_dev_t* dev, void* data, size_t offset, uint8_t size)
+{
+    virtio_gpu_dev_t* vg = dev->data;
+    uint32_t val = mmio_load_u32(data, size);
+
+    if (offset >= VIRTIO_MMIO_CONFIG) {
+        // events_clear: no events are ever raised
+        return true;
+    }
+
+    switch (offset) {
+        case VIRTIO_MMIO_DEVICE_FEATURES_SEL:
+            vg->host_features_sel = val & 1;
+            break;
+        case VIRTIO_MMIO_DRIVER_FEATURES:
+            vg->driver_features[vg->driver_features_sel & 1] = val;
+            break;
+        case VIRTIO_MMIO_DRIVER_FEATURES_SEL:
+            vg->driver_features_sel = val & 1;
+            break;
+        case VIRTIO_MMIO_SHM_SEL:
+            vg->shm_sel = val;
+            break;
+        case VIRTIO_MMIO_QUEUE_SEL:
+            vg->queue_sel = val & 1;
+            break;
+        case VIRTIO_MMIO_QUEUE_NUM:
+            if (val > 0 && val <= 64) {
+                vg->q[vg->queue_sel & 1].num = (uint16_t)val;
+                vg->q[vg->queue_sel & 1].last_avail_idx = 0;
+                vg->q[vg->queue_sel & 1].used_idx = 0;
+            }
+            break;
+        case VIRTIO_MMIO_QUEUE_READY:
+            vg->q[vg->queue_sel & 1].ready = (val != 0);
+            if (val == 0) {
+                vg->q[vg->queue_sel & 1].desc_addr = 0;
+                vg->q[vg->queue_sel & 1].avail_addr = 0;
+                vg->q[vg->queue_sel & 1].used_addr = 0;
+            }
+            break;
+        case VIRTIO_MMIO_QUEUE_NOTIFY: {
+            uint32_t idx = val & 1;
+            if (idx < STATIC_ARRAY_SIZE(vg->q)) {
+                virtio_gpu_process_queue(vg, &vg->q[idx], idx == 1);
+            }
+            break;
+        }
+        case VIRTIO_MMIO_INTERRUPT_ACK:
+            vg->interrupt_status &= ~val;
+            if (!vg->interrupt_status) {
+                rvvm_lower_irq(vg->intc, vg->irq);
+            }
+            break;
+        case VIRTIO_MMIO_STATUS:
+            vg->status = val & 0xFF;
+            if (val == 0) {
+                virtio_gpu_reset(vg);
+            }
+            break;
+        case VIRTIO_MMIO_QUEUE_DESC_LOW:
+            vg->q[vg->queue_sel & 1].desc_addr = (vg->q[vg->queue_sel & 1].desc_addr & ~0xFFFFFFFFULL) | val;
+            break;
+        case VIRTIO_MMIO_QUEUE_DESC_HIGH:
+            vg->q[vg->queue_sel & 1].desc_addr = (vg->q[vg->queue_sel & 1].desc_addr & 0xFFFFFFFFULL)
+                                                 | ((uint64_t)val << 32);
+            break;
+        case VIRTIO_MMIO_QUEUE_AVAIL_LOW:
+            vg->q[vg->queue_sel & 1].avail_addr = (vg->q[vg->queue_sel & 1].avail_addr & ~0xFFFFFFFFULL) | val;
+            break;
+        case VIRTIO_MMIO_QUEUE_AVAIL_HIGH:
+            vg->q[vg->queue_sel & 1].avail_addr = (vg->q[vg->queue_sel & 1].avail_addr & 0xFFFFFFFFULL)
+                                                  | ((uint64_t)val << 32);
+            break;
+        case VIRTIO_MMIO_QUEUE_USED_LOW:
+            vg->q[vg->queue_sel & 1].used_addr = (vg->q[vg->queue_sel & 1].used_addr & ~0xFFFFFFFFULL) | val;
+            break;
+        case VIRTIO_MMIO_QUEUE_USED_HIGH:
+            vg->q[vg->queue_sel & 1].used_addr = (vg->q[vg->queue_sel & 1].used_addr & 0xFFFFFFFFULL)
+                                                 | ((uint64_t)val << 32);
+            break;
+        default:
+            break;
+    }
+    return true;
+}
+
+/*
+ * Snapshot support
+ */
+static void virtio_gpu_suspend(rvvm_mmio_dev_t* dev, rvvm_snapshot_t* snap, bool resume)
+{
+    virtio_gpu_dev_t* vg = dev->data;
+
+    rvvm_snapshot_section(snap, "virtio-gpu");
+
+    rvvm_snapshot_field(snap, vg->status);
+    rvvm_snapshot_field(snap, vg->interrupt_status);
+    rvvm_snapshot_field(snap, vg->queue_sel);
+    rvvm_snapshot_field(snap, vg->config_generation);
+    rvvm_snapshot_field(snap, vg->driver_features);
+    rvvm_snapshot_field(snap, vg->cursor);
+    rvvm_snapshot_field(snap, vg->fence_seq);
+
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->q); ++i) {
+        rvvm_snapshot_field(snap, vg->q[i].num);
+        rvvm_snapshot_field(snap, vg->q[i].ready);
+        rvvm_snapshot_field(snap, vg->q[i].last_avail_idx);
+        rvvm_snapshot_field(snap, vg->q[i].used_idx);
+        rvvm_snapshot_field(snap, vg->q[i].desc_addr);
+        rvvm_snapshot_field(snap, vg->q[i].avail_addr);
+        rvvm_snapshot_field(snap, vg->q[i].used_addr);
+    }
+
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->scanout); ++i) {
+        rvvm_snapshot_field(snap, vg->scanout[i]);
+    }
+
+    // Resources: only 2D contents are host-side; 3D resources live in the backend
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->resources); ++i) {
+        virtio_gpu_resource_t* res = &vg->resources[i];
+        rvvm_snapshot_field(snap, res->id);
+        rvvm_snapshot_field(snap, res->used);
+        rvvm_snapshot_field(snap, res->is_3d);
+        rvvm_snapshot_field(snap, res->is_cursor);
+        rvvm_snapshot_field(snap, res->width);
+        rvvm_snapshot_field(snap, res->height);
+        rvvm_snapshot_field(snap, res->bpp);
+        rvvm_snapshot_field(snap, res->format);
+        rvvm_snapshot_field(snap, res->iovec_count);
+        rvvm_snapshot_field(snap, res->iovec);
+        rvvm_snapshot_field(snap, res->backing_size);
+
+        if (res->used && !res->is_3d && res->backing_size > 0 && res->backing_size <= VIRTIO_GPU_MAX_RESOURCE_SIZE) {
+            if (!rvvm_snapshot_writing(snap)) {
+                if (!res->backing) {
+                    res->backing = calloc(1, res->backing_size);
+                    if (!res->backing) {
+                        rvvm_snapshot_data(snap, NULL, 1);
+                        res->backing_size = 0;
+                        continue;
+                    }
+                }
+            }
+            rvvm_snapshot_data(snap, res->backing, res->backing_size);
+        }
+    }
+
+    // VRAM scanout contents
+    size_t vram_used = 0;
+    if (vg->vram && vg->scanout[0].enabled) {
+        vram_used = (size_t)vg->scanout[0].width * vg->scanout[0].height * 4;
+        if (vram_used > vg->vram_size) {
+            vram_used = vg->vram_size;
+        }
+    }
+    rvvm_snapshot_field(snap, vram_used);
+    if (vram_used > 0) {
+        rvvm_snapshot_data(snap, vg->vram, vram_used);
+    }
+
+    if (resume) {
+        // Re-apply scanout & re-raise IRQ if pending
+        vg_scanout_apply(vg);
+        if (vg->scanout[0].enabled && vg->scanout[0].resource_id) {
+            virtio_gpu_rect_t whole = {
+                .x = vg->scanout[0].x,
+                .y = vg->scanout[0].y,
+                .width = vg->scanout[0].width,
+                .height = vg->scanout[0].height,
+            };
+            vg_scanout_blit(vg, &whole);
+        }
+        if (vg->interrupt_status) {
+            rvvm_raise_irq(vg->intc, vg->irq);
+        } else {
+            rvvm_lower_irq(vg->intc, vg->irq);
+        }
+    }
+}
+
+static void virtio_gpu_remove(rvvm_mmio_dev_t* dev)
+{
+    virtio_gpu_dev_t* vg = dev->data;
+
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg->resources); ++i) {
+        if (vg->resources[i].used) {
+            vg_resource_unref(vg, &vg->resources[i]);
+        }
+    }
+
+    vg_venus_unload(vg);
+
+    free(vg->req_buf);
+    free(vg->resp_buf);
+    if (vg->owns_vram && vg->vram) {
+        vma_free(vg->vram, vg->vram_size);
+    }
+    if (vg->owns_fbdev_ref) {
+        rvvm_fbdev_dec_ref(vg->fbdev);
+    }
+    free(vg);
+}
+
+static const rvvm_mmio_type_t virtio_gpu_type = {
+    .name = "virtio_gpu",
+    .remove = virtio_gpu_remove,
+    .suspend = virtio_gpu_suspend,
+};
+
+/*
+ * Public API
+ */
+PUBLIC rvvm_mmio_dev_t* virtio_gpu_init(rvvm_machine_t* machine, rvvm_addr_t addr, rvvm_intc_t* intc, rvvm_irq_t irq,
+                                        rvvm_fbdev_t* fbdev, uint32_t width, uint32_t height)
+{
+    if (!machine || !intc || !fbdev) {
+        return NULL;
+    }
+    if (width == 0 || height == 0 || width > 4096 || height > 4096) {
+        width = 1280;
+        height = 800;
+    }
+
+    virtio_gpu_dev_t* vg = calloc(1, sizeof(virtio_gpu_dev_t));
+    if (!vg) {
+        return NULL;
+    }
+
+    vg->machine = machine;
+    vg->intc = intc;
+    vg->irq = irq;
+    vg->fbdev = fbdev;
+    vg->disp_width = width;
+    vg->disp_height = height;
+    vg->buf_cap = 16u << 10;
+    vg->req_buf = calloc(1, vg->buf_cap);
+    vg->resp_buf = calloc(1, vg->buf_cap);
+    if (!vg->req_buf || !vg->resp_buf) {
+        free(vg->req_buf);
+        free(vg->resp_buf);
+        free(vg);
+        return NULL;
+    }
+
+    // Feature bits: VERSION_1, INDIRECT, EVENT_IDX, EDID (+ VIRGL/BLOB/CONTEXT_INIT when venus loads)
+    vg->host_features[VIRTIO_GPU_F_EDID / 32] |= 1U << (VIRTIO_GPU_F_EDID % 32);
+    vg->host_features[VIRTIO_RING_F_INDIRECT_DESC / 32] |= 1U << (VIRTIO_RING_F_INDIRECT_DESC % 32);
+    vg->host_features[VIRTIO_RING_F_EVENT_IDX / 32] |= 1U << (VIRTIO_RING_F_EVENT_IDX % 32);
+    vg->host_features[VIRTIO_F_VERSION_1 / 32] |= 1U << (VIRTIO_F_VERSION_1 % 32);
+
+    // VRAM: reuse the display-provided one, or allocate our own
+    size_t need = (size_t)width * height * 4;
+    size_t existing_size = 0;
+    void* existing = rvvm_fbdev_get_vram(fbdev, &existing_size);
+    if (existing && existing_size >= need) {
+        vg->vram = existing;
+        vg->vram_size = existing_size;
+        vg->owns_vram = false;
+    } else {
+        vg->vram_size = need;
+        vg->vram = vma_alloc(NULL, vg->vram_size, VMA_RDWR);
+        if (!vg->vram) {
+            free(vg);
+            return NULL;
+        }
+        vg->owns_vram = true;
+        rvvm_fbdev_set_vram(fbdev, vg->vram, vg->vram_size);
+    }
+
+    // Present a blank default mode
+    memset(vg->vram, 0, vg->vram_size);
+    vg_scanout_apply(vg);
+
+    rvvm_mmio_dev_t mmio_desc = {
+        .addr = addr,
+        .size = 0x1000,
+        .data = vg,
+        .type = &virtio_gpu_type,
+        .read = virtio_gpu_mmio_read,
+        .write = virtio_gpu_mmio_write,
+        .min_op_size = 1,
+        .max_op_size = 4,
+    };
+
+    rvvm_mmio_dev_t* mmio = rvvm_attach_mmio(machine, &mmio_desc);
+    if (!mmio) {
+        if (vg->owns_vram) {
+            vma_free(vg->vram, vg->vram_size);
+        }
+        free(vg);
+        return NULL;
+    }
+
+    // Keep a reference so the fbdev outlives device removal
+    rvvm_fbdev_inc_ref(fbdev);
+    vg->owns_fbdev_ref = true;
+
+#ifdef USE_FDT
+    struct fdt_node* node = fdt_node_create_reg("virtio_mmio", mmio_desc.addr);
+    fdt_node_add_prop_reg(node, "reg", mmio_desc.addr, mmio_desc.size);
+    fdt_node_add_prop_str(node, "compatible", "virtio,mmio");
+    rvvm_fdt_describe_irq(node, intc, irq);
+    fdt_node_add_child(rvvm_get_fdt_soc(machine), node);
+#endif
+
+    rvvm_info("virtio-gpu: %ux%u display at 0x%llx", width, height, (unsigned long long)addr);
+    return mmio;
+}
+
+PUBLIC rvvm_mmio_dev_t* virtio_gpu_init_auto(rvvm_machine_t* machine, rvvm_fbdev_t* fbdev, uint32_t width,
+                                             uint32_t height)
+{
+    rvvm_intc_t* intc = rvvm_get_intc(machine);
+    rvvm_addr_t addr = rvvm_mmio_zone_auto(machine, VIRTIO_GPU_MMIO_ADDR_DEFAULT, 0x1000);
+    return virtio_gpu_init(machine, addr, intc, rvvm_alloc_irq(intc), fbdev, width, height);
+}
+
+PUBLIC bool virtio_gpu_get_cursor(rvvm_mmio_dev_t* dev, virtio_gpu_cursor_info_t* out)
+{
+    if (!dev || !dev->data || dev->type != &virtio_gpu_type || !out) {
+        return false;
+    }
+    virtio_gpu_dev_t* vg = dev->data;
+    if (!vg->cursor.visible) {
+        return false;
+    }
+    *out = vg->cursor;
+    return true;
+}
+
+PUBLIC size_t virtio_gpu_get_cursor_bitmap(rvvm_mmio_dev_t* dev, uint32_t width, uint32_t height, void* out,
+                                           size_t cap)
+{
+    if (!dev || !dev->data || dev->type != &virtio_gpu_type || !out) {
+        return 0;
+    }
+    virtio_gpu_dev_t* vg = dev->data;
+    if (!vg->cursor.visible) {
+        return 0;
+    }
+    virtio_gpu_resource_t* res = vg_resource_find(vg, vg->cursor.resource_id);
+    if (!res || res->bpp != 32 || res->width != width || res->height != height) {
+        return 0;
+    }
+    size_t need = (size_t)width * height * 4;
+    if (cap < need || !res->backing) {
+        return 0;
+    }
+    memcpy(out, res->backing, need);
+    return need;
+}
+
+PUBLIC bool virtio_gpu_init_venus(rvvm_mmio_dev_t* dev, const char* libpath, uint32_t flags)
+{
+    if (!dev || !dev->data || dev->type != &virtio_gpu_type) {
+        return false;
+    }
+    virtio_gpu_dev_t* vg = dev->data;
+    if (vg->venus) {
+        return true;
+    }
+    if (vg->status != 0) {
+        rvvm_warn("virtio-gpu: cannot attach venus backend after driver init");
+        return false;
+    }
+    bool ok = vg_venus_load(vg, libpath, flags);
+    if (ok) {
+        // Reserve the host-visible blob window (virtio SHM region). The guest
+        // kernel allocates offsets inside it for blob mappings.
+        if (!vg->win_base) {
+            vg->win_size = VG_VENUS_WINDOW_SIZE;
+            vg->win_base = rvvm_mmio_zone_auto(vg->machine, VG_VENUS_WINDOW_BASE, vg->win_size);
+            if (vg->win_base != VG_VENUS_WINDOW_BASE) {
+                // Auto-placed elsewhere: keep it, the SHM registers report it
+                rvvm_info("virtio-gpu: host-visible window at 0x%llx (%zu MiB)",
+                          (unsigned long long)vg->win_base, vg->win_size >> 20);
+            }
+        }
+        if (!vg->poller_thread) {
+            __atomic_store_n(&vg->stop_poller, 0, __ATOMIC_RELEASE);
+            vg->poller_thread = rvvm_thread_create(vg_venus_poller_thread, vg);
+        }
+        vg->config_generation++;
+    }
+    return ok;
+}
diff --git a/src/devices/virtio-gpu.h b/src/devices/virtio-gpu.h
new file mode 100644
index 0000000..366ea6c
--- /dev/null
+++ b/src/devices/virtio-gpu.h
@@ -0,0 +1,46 @@
+#ifndef RVVM_VIRTIO_GPU_H
+#define RVVM_VIRTIO_GPU_H
+
+#include "rvvmlib.h"
+
+#define VIRTIO_GPU_MMIO_ADDR_DEFAULT 0x10004000U
+
+/*
+ * Cursor state, for display layers willing to composite the guest cursor
+ */
+typedef struct {
+    bool     visible;
+    uint32_t resource_id;
+    int32_t  pos_x;
+    int32_t  pos_y;
+    uint32_t hot_x;
+    uint32_t hot_y;
+} virtio_gpu_cursor_info_t;
+
+PUBLIC rvvm_mmio_dev_t* virtio_gpu_init(rvvm_machine_t* machine, rvvm_addr_t addr, rvvm_intc_t* intc, rvvm_irq_t irq,
+                                        rvvm_fbdev_t* fbdev, uint32_t width, uint32_t height);
+
+PUBLIC rvvm_mmio_dev_t* virtio_gpu_init_auto(rvvm_machine_t* machine, rvvm_fbdev_t* fbdev, uint32_t width,
+                                             uint32_t height);
+
+/*
+ * Query guest cursor state. Returns false if the cursor is hidden.
+ * The cursor bitmap itself lives in the cursor resource, queried below.
+ */
+PUBLIC bool virtio_gpu_get_cursor(rvvm_mmio_dev_t* dev, virtio_gpu_cursor_info_t* out);
+
+/*
+ * Copy the current guest cursor bitmap (32bpp XRGB8888) into out (cap bytes).
+ * Returns the actual size, or zero if hidden/unavailable.
+ */
+PUBLIC size_t virtio_gpu_get_cursor_bitmap(rvvm_mmio_dev_t* dev, uint32_t width, uint32_t height, void* out, size_t cap);
+
+/*
+ * Initialize the venus 3D backend (virglrenderer + Vulkan; MoltenVK on iOS).
+ * Loads libvirglrenderer at runtime via dlopen; on failure the device stays
+ * in 2D mode. libpath may be NULL to search the default library paths.
+ */
+#define VIRTIO_GPU_VENUS_FLAG_NO_VIRGL 0x1 /* advertise only the venus capset */
+PUBLIC bool virtio_gpu_init_venus(rvvm_mmio_dev_t* dev, const char* libpath, uint32_t flags);
+
+#endif
diff --git a/tests/virtio-gpu/README.md b/tests/virtio-gpu/README.md
new file mode 100644
index 0000000..6a43863
--- /dev/null
+++ b/tests/virtio-gpu/README.md
@@ -0,0 +1,40 @@
+# virtio-gpu device test
+
+A self-contained bare-metal protocol test for the virtio-gpu device, runnable
+headlessly on any host platform (no GUI, no Linux image required).
+
+## What it covers
+
+- virtio-mmio identification & feature negotiation (`VIRTIO_F_VERSION_1`, EDID,
+  indirect descriptors, event idx)
+- Control & cursor virtqueue setup, used-ring handling, IRQ signaling
+- `GET_DISPLAY_INFO` (mode 0 = the device's display size)
+- `GET_EDID` (header + checksum validation)
+- `RESOURCE_CREATE_2D` / `RESOURCE_UNREF` (including the invalid-id error path)
+- `RESOURCE_ATTACH_BACKING` + `TRANSFER_TO_HOST_2D` (with fence id echo)
+- `SET_SCANOUT` / `RESOURCE_FLUSH` -> host verifies exact pixel contents in VRAM
+- `UPDATE_CURSOR` / `MOVE_CURSOR` -> host verifies cursor state & bitmap
+
+## Building & running
+
+The guest payload is a freestanding RISC-V binary; any C compiler that can
+target `riscv64-freestanding` works (zig cc shown here):
+
+    zig cc -target riscv64-freestanding-none -mcmodel=medany -nostdlib \
+        -ffreestanding -O1 -Wl,-T,link.ld -Wl,--build-id=none \
+        -o vgtest.elf vgtest_payload.c
+
+The host harness links against the built librvvm:
+
+    gcc -o vgtest_host vgtest_host.c \
+        -I../../include -I../../src -I../../src/util -I../../src/devices \
+        -L../../release.linux.$(arch) -lrvvm -Wl,-rpath,../../release.linux.$(arch) \
+        -pthread
+
+Run (expects vgtest.elf in the current directory):
+
+    ./vgtest_host ./vgtest.elf
+
+Expected output ends with `VGTEST: ALL PASS` from the guest,
+`vgtest: scanout pixels verified`, `vgtest: cursor verified`,
+`vgtest: PASSED` from the host, exit code 0.
diff --git a/tests/virtio-gpu/link.ld b/tests/virtio-gpu/link.ld
new file mode 100644
index 0000000..1f6fa8c
--- /dev/null
+++ b/tests/virtio-gpu/link.ld
@@ -0,0 +1,36 @@
+OUTPUT_ARCH("riscv")
+OUTPUT_FORMAT("elf64-littleriscv")
+ENTRY(_start)
+
+SECTIONS
+{
+    . = 0x80000000;
+
+    .text : {
+        KEEP(*(.text.init))
+        *(.text.startup)
+        *(.text .text.*)
+    }
+
+    .rodata : ALIGN(16) {
+        *(.rodata .rodata.*)
+        *(.srodata .srodata.*)
+    }
+
+    .data : ALIGN(16) {
+        __global_pointer$ = . + 0x800;
+        *(.data .data.*)
+        *(.sdata .sdata.*)
+    }
+
+    .bss (NOLOAD) : ALIGN(16) {
+        __bss_start = .;
+        *(.bss .bss.*)
+        *(.sbss .sbss.*)
+        *(COMMON)
+        . = ALIGN(16);
+        __bss_end = .;
+    }
+
+    /DISCARD/ : { *(.eh_frame .eh_frame_hdr .note .note.* .comment .riscv.attributes) }
+}
diff --git a/tests/virtio-gpu/vgtest_host.c b/tests/virtio-gpu/vgtest_host.c
new file mode 100644
index 0000000..e2816d6
--- /dev/null
+++ b/tests/virtio-gpu/vgtest_host.c
@@ -0,0 +1,197 @@
+/*
+ * vgtest_host.c - host-side harness for the virtio-gpu bare-metal test
+ *
+ * Boots tests/virtio-gpu/vgtest.elf in a headless RVVM machine with the
+ * virtio-gpu device attached, captures guest serial output, and verifies
+ * the scanout contents in VRAM plus the cursor state.
+ *
+ * Build:
+ *   gcc -o vgtest_host vgtest_host.c -I../../include -I../../src -I../../src/util \
+ *       -I../../src/devices -L<libdir> -lrvvm -Wl,-rpath,<libdir> -pthread
+ */
+
+#include <rvvm/rvvm.h>
+#include <rvvm/rvvm_board.h>
+#include <rvvm/rvvm_fb.h>
+
+#include <devices/ns16550a.h>
+#include <devices/virtio-gpu.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define VRAM_W 1280
+#define VRAM_H 800
+
+static int serial_pipe[2]; // serial_pipe[0] = read end (host), [1] = write end (guest)
+
+static void millisleep(long ms)
+{
+    struct timespec ts = {
+        .tv_sec = ms / 1000,
+        .tv_nsec = (ms % 1000) * 1000000L,
+    };
+    nanosleep(&ts, NULL);
+}
+
+int main(int argc, char** argv)
+{
+    const char* fw = (argc > 1) ? argv[1] : "vgtest.elf";
+    int failures = 0;
+
+    if (pipe(serial_pipe) != 0) {
+        perror("pipe");
+        return 2;
+    }
+    // Non-blocking read on the host end
+    fcntl(serial_pipe[0], F_SETFL, O_NONBLOCK);
+
+    rvvm_machine_t* machine = rvvm_create_machine(64U << 20, 1, "rv64");
+    if (!machine) {
+        fprintf(stderr, "vgtest: failed to create machine\n");
+        return 2;
+    }
+
+    if (!rvvm_load_firmware(machine, fw)) {
+        fprintf(stderr, "vgtest: failed to load firmware %s\n", fw);
+        return 2;
+    }
+
+    // RISC-V virt board: CLINT + PLIC + PCIe + syscon (provides machine intc)
+    if (!rvvm_board_riscv_virt_init(machine, false)) {
+        fprintf(stderr, "vgtest: failed to init board\n");
+        return 2;
+    }
+
+    // Serial console: guest output appears on serial_pipe[1]
+    chardev_t* con = chardev_fd_create(serial_pipe[0], serial_pipe[1]);
+    ns16550a_init_auto(machine, con);
+
+    // Headless framebuffer + virtio-gpu
+    rvvm_fbdev_t* fbdev = rvvm_fbdev_init();
+    rvvm_mmio_dev_t* gpu = virtio_gpu_init_auto(machine, fbdev, VRAM_W, VRAM_H);
+    if (!gpu) {
+        fprintf(stderr, "vgtest: virtio_gpu_init_auto failed\n");
+        return 2;
+    }
+
+    // Let the interpreter do its job
+    if (!rvvm_start_machine(machine)) {
+        fprintf(stderr, "vgtest: failed to start machine\n");
+        return 2;
+    }
+
+    char log[65536];
+    size_t log_len = 0;
+    log[0] = 0;
+    bool all_pass = false;
+    bool any_fail = false;
+
+    for (int iter = 0; iter < 1500; iter++) {
+        char chunk[512];
+        ssize_t r = read(serial_pipe[0], chunk, sizeof(chunk));
+        if (r > 0) {
+            size_t take = (size_t)r;
+            if (log_len + take >= sizeof(log) - 1) {
+                take = sizeof(log) - 1 - log_len;
+            }
+            memcpy(log + log_len, chunk, take);
+            log_len += take;
+            log[log_len] = 0;
+        }
+        if (strstr(log, "ALL PASS")) {
+            all_pass = true;
+            break;
+        }
+        if (strstr(log, "FAIL")) {
+            any_fail = true;
+            break;
+        }
+        millisleep(10);
+    }
+
+    // Give the device a moment to settle the final flush
+    millisleep(100);
+    rvvm_pause_machine(machine);
+
+    printf("---- guest serial log ----\n%s--------------------------\n", log);
+
+    if (!all_pass) {
+        fprintf(stderr, "vgtest: guest did not report ALL PASS\n");
+        failures++;
+    }
+
+    // Verify scanout mode
+    rvvm_fb_t fb;
+    if (!rvvm_fbdev_get_scanout(fbdev, &fb)) {
+        fprintf(stderr, "vgtest: no scanout set\n");
+        failures++;
+    } else if (rvvm_fb_width(&fb) != 64 || rvvm_fb_height(&fb) != 64) {
+        fprintf(stderr, "vgtest: scanout is %ux%u, expected 64x64\n", rvvm_fb_width(&fb), rvvm_fb_height(&fb));
+        failures++;
+    } else {
+        // Verify the gradient: pixel(x,y) = {B=0xFF-2y, G=4x, R=0x80}
+        uint8_t* vram = (uint8_t*)rvvm_fb_buffer(&fb);
+        size_t stride = rvvm_fb_stride(&fb);
+        uint32_t checked = 0;
+        uint32_t bad = 0;
+        for (uint32_t y = 0; y < 64; y += 7) {
+            for (uint32_t x = 0; x < 64; x += 5) {
+                uint8_t* px = vram + (size_t)y * stride + (size_t)x * 4;
+                uint8_t eb = (uint8_t)(0xFFU - 2 * y);
+                uint8_t eg = (uint8_t)(x * 4);
+                uint8_t er = 0x80;
+                if (px[0] != eb || px[1] != eg || px[2] != er) {
+                    if (bad < 4) {
+                        fprintf(stderr, "vgtest: pixel(%u,%u) = %02x%02x%02x, expected %02x%02x%02x\n", x, y,
+                                px[2], px[1], px[0], er, eg, eb);
+                    }
+                    bad++;
+                }
+                checked++;
+            }
+        }
+        if (bad) {
+            fprintf(stderr, "vgtest: %u/%u scanout pixels wrong\n", bad, checked);
+            failures++;
+        } else {
+            printf("vgtest: scanout pixels verified (%u sampled)\n", checked);
+        }
+    }
+
+    // Verify cursor state (after MOVE_CURSOR: pos 30,40)
+    virtio_gpu_cursor_info_t cur;
+    if (!virtio_gpu_get_cursor(gpu, &cur)) {
+        fprintf(stderr, "vgtest: cursor not visible\n");
+        failures++;
+    } else if (cur.resource_id != 3 || cur.pos_x != 30 || cur.pos_y != 40 || cur.hot_x != 2 || cur.hot_y != 2) {
+        fprintf(stderr, "vgtest: cursor state wrong: res=%u pos=%d,%d hot=%u,%u\n", cur.resource_id, cur.pos_x,
+                cur.pos_y, cur.hot_x, cur.hot_y);
+        failures++;
+    } else {
+        // Verify cursor bitmap: 8x8, guest filled with 0xFF00FF00 (A8R8G8B8: bytes 00 FF 00 FF)
+        uint32_t bmp[64];
+        size_t n = virtio_gpu_get_cursor_bitmap(gpu, 8, 8, bmp, sizeof(bmp));
+        if (n != sizeof(bmp) || bmp[0] != 0xFF00FF00U || bmp[63] != 0xFF00FF00U) {
+            fprintf(stderr, "vgtest: cursor bitmap wrong (n=%zu first=%08x)\n", n, n ? bmp[0] : 0);
+            failures++;
+        } else {
+            printf("vgtest: cursor verified\n");
+        }
+    }
+
+    rvvm_free_machine(machine);
+
+    if (failures || any_fail) {
+        fprintf(stderr, "vgtest: FAILED (%d failures)\n", failures);
+        return 1;
+    }
+    printf("vgtest: PASSED\n");
+    return 0;
+}
diff --git a/tests/virtio-gpu/vgtest_payload.c b/tests/virtio-gpu/vgtest_payload.c
new file mode 100644
index 0000000..4e758fb
--- /dev/null
+++ b/tests/virtio-gpu/vgtest_payload.c
@@ -0,0 +1,555 @@
+/*
+ * vgtest_payload.c - bare-metal RISC-V virtio-gpu exerciser for RVVM
+ *
+ * Runs in M-mode at 0x80000000 (loaded as "firmware"), talks to the
+ * virtio-gpu device at 0x10004000 over virtio-mmio, prints results
+ * over the ns16550a UART at 0x10000000.
+ *
+ * Build (zig cc cross compiler):
+ *   zig cc -target riscv64-freestanding-none -mcmodel=medany -nostdlib \
+ *        -ffreestanding -O2 -Wl,-Ttext=0x80000000 -Wl,--build-id=none \
+ *        -o vgtest.elf vgtest_payload.c
+ */
+
+typedef unsigned long long u64;
+typedef unsigned int u32;
+typedef unsigned short u16;
+typedef unsigned char u8;
+typedef unsigned long uintptr_t;
+
+#define UART_BASE 0x10000000UL
+#define VGPU_BASE 0x10004000UL
+
+/* virtio-mmio registers */
+#define VIRTIO_MMIO_MAGIC             0x000
+#define VIRTIO_MMIO_VERSION           0x004
+#define VIRTIO_MMIO_DEVICE_ID         0x008
+#define VIRTIO_MMIO_VENDOR_ID         0x00c
+#define VIRTIO_MMIO_DEVICE_FEATURES   0x010
+#define VIRTIO_MMIO_DEVICE_FEATURES_SEL 0x014
+#define VIRTIO_MMIO_DRIVER_FEATURES   0x020
+#define VIRTIO_MMIO_DRIVER_FEATURES_SEL 0x024
+#define VIRTIO_MMIO_QUEUE_SEL         0x030
+#define VIRTIO_MMIO_QUEUE_NUM_MAX     0x034
+#define VIRTIO_MMIO_QUEUE_NUM         0x038
+#define VIRTIO_MMIO_QUEUE_READY       0x044
+#define VIRTIO_MMIO_QUEUE_NOTIFY      0x050
+#define VIRTIO_MMIO_INTERRUPT_STATUS  0x060
+#define VIRTIO_MMIO_INTERRUPT_ACK     0x064
+#define VIRTIO_MMIO_STATUS            0x070
+#define VIRTIO_MMIO_QUEUE_DESC_LOW    0x080
+#define VIRTIO_MMIO_QUEUE_DESC_HIGH   0x084
+#define VIRTIO_MMIO_QUEUE_AVAIL_LOW   0x090
+#define VIRTIO_MMIO_QUEUE_AVAIL_HIGH  0x094
+#define VIRTIO_MMIO_QUEUE_USED_LOW    0x0a0
+#define VIRTIO_MMIO_QUEUE_USED_HIGH   0x0a4
+
+#define VIRTIO_STATUS_ACK         1
+#define VIRTIO_STATUS_DRIVER      2
+#define VIRTIO_STATUS_DRIVER_OK   4
+#define VIRTIO_STATUS_FEATURES_OK 8
+
+#define VIRTQ_DESC_F_NEXT  1
+#define VIRTQ_DESC_F_WRITE 2
+
+/* virtio-gpu commands & responses */
+#define CMD_GET_DISPLAY_INFO   0x0100
+#define CMD_RESOURCE_CREATE_2D 0x0101
+#define CMD_RESOURCE_UNREF     0x0102
+#define CMD_SET_SCANOUT        0x0103
+#define CMD_RESOURCE_FLUSH     0x0104
+#define CMD_TRANSFER_TO_HOST_2D 0x0105
+#define CMD_RESOURCE_ATTACH_BACKING 0x0106
+#define CMD_GET_EDID           0x0120
+#define CMD_UPDATE_CURSOR      0x0300
+#define CMD_MOVE_CURSOR        0x0301
+
+#define RESP_OK_NODATA        0x8000
+#define RESP_OK_DISPLAY_INFO  0x8100
+#define RESP_OK_EDID          0x8104
+#define RESP_ERR_INVALID_RESOURCE_ID 0x8203
+
+#define FMT_B8G8R8X8 2
+#define FMT_A8R8G8B8 3
+
+static volatile u8* const uart = (volatile u8*)UART_BASE;
+static volatile u32* const vgpu = (volatile u32*)VGPU_BASE;
+
+static void uart_putc(char c)
+{
+    *uart = (u8)c;
+}
+
+static void uart_puts(const char* s)
+{
+    while (*s) {
+        uart_putc(*s++);
+    }
+}
+
+static void uart_puthex(u32 v)
+{
+    static const char hex[] = "0123456789abcdef";
+    uart_puts("0x");
+    for (int i = 7; i >= 0; i--) {
+        uart_putc(hex[(v >> (i * 4)) & 0xF]);
+    }
+}
+
+static u32 mmio_read(u32 off)
+{
+    return vgpu[off / 4];
+}
+
+static void mmio_write(u32 off, u32 val)
+{
+    vgpu[off / 4] = val;
+}
+
+static void mmio_write64(u32 off_lo, u64 val)
+{
+    mmio_write(off_lo, (u32)(val & 0xFFFFFFFFU));
+    mmio_write(off_lo + 4, (u32)(val >> 32));
+}
+
+/*
+ * Virtqueues in static memory (physical RAM at link addresses)
+ */
+#define QNUM 32
+
+struct virtq_desc {
+    u64 addr;
+    u32 len;
+    u16 flags;
+    u16 next;
+} __attribute__((packed));
+
+struct virtq_avail_s {
+    u16 flags;
+    u16 idx;
+    u16 ring[QNUM];
+} __attribute__((packed));
+
+struct virtq_used_elem {
+    u32 id;
+    u32 len;
+} __attribute__((packed));
+
+struct virtq_used_s {
+    u16 flags;
+    u16 idx;
+    struct virtq_used_elem ring[QNUM];
+} __attribute__((packed));
+
+static struct virtq_desc ctrl_desc[QNUM] __attribute__((aligned(4096)));
+static struct virtq_avail_s ctrl_avail __attribute__((aligned(4096)));
+static struct virtq_used_s ctrl_used __attribute__((aligned(4096)));
+
+static struct virtq_desc cur_desc[QNUM] __attribute__((aligned(4096)));
+static struct virtq_avail_s cur_avail __attribute__((aligned(4096)));
+static struct virtq_used_s cur_used __attribute__((aligned(4096)));
+
+static u8 cmd_buf[4096] __attribute__((aligned(4096)));
+static u8 resp_buf[4096] __attribute__((aligned(4096)));
+static u32 fb64[64 * 64] __attribute__((aligned(4096)));
+static u32 cursor_img[8 * 8] __attribute__((aligned(4096)));
+
+static u16 ctrl_last_used = 0;
+static u16 cur_last_used = 0;
+
+static void barrier(void)
+{
+    __asm__ volatile("fence rw, rw" ::: "memory");
+}
+
+static void fail(const char* what, u32 code)
+{
+    uart_puts("VGTEST: FAIL ");
+    uart_puts(what);
+    uart_puts(" code=");
+    uart_puthex(code);
+    uart_putc('\n');
+    for (;;) {
+        __asm__ volatile("wfi");
+    }
+}
+
+static void ok(const char* what)
+{
+    uart_puts("VGTEST: ");
+    uart_puts(what);
+    uart_puts(" OK\n");
+}
+
+static void setup_queue(u32 qidx, void* desc, void* avail, void* used)
+{
+    mmio_write(VIRTIO_MMIO_QUEUE_SEL, qidx);
+    mmio_write(VIRTIO_MMIO_QUEUE_NUM, QNUM);
+    mmio_write64(VIRTIO_MMIO_QUEUE_DESC_LOW, (u64)(uintptr_t)desc);
+    mmio_write64(VIRTIO_MMIO_QUEUE_AVAIL_LOW, (u64)(uintptr_t)avail);
+    mmio_write64(VIRTIO_MMIO_QUEUE_USED_LOW, (u64)(uintptr_t)used);
+    mmio_write(VIRTIO_MMIO_QUEUE_READY, 1);
+}
+
+/*
+ * Send a control-queue command built in cmd_buf (cmd_len bytes),
+ * response lands in resp_buf. Returns response type.
+ */
+static u32 send_ctrl(u32 cmd_len)
+{
+    ctrl_desc[0].addr = (u64)(uintptr_t)cmd_buf;
+    ctrl_desc[0].len = cmd_len;
+    ctrl_desc[0].flags = VIRTQ_DESC_F_NEXT;
+    ctrl_desc[0].next = 1;
+
+    ctrl_desc[1].addr = (u64)(uintptr_t)resp_buf;
+    ctrl_desc[1].len = sizeof(resp_buf);
+    ctrl_desc[1].flags = VIRTQ_DESC_F_WRITE;
+    ctrl_desc[1].next = 0;
+
+    barrier();
+
+    ctrl_avail.ring[ctrl_avail.idx % QNUM] = 0;
+    ctrl_avail.idx++;
+
+    barrier();
+
+    mmio_write(VIRTIO_MMIO_QUEUE_NOTIFY, 0);
+
+    u32 spins = 0;
+    while (ctrl_used.idx == ctrl_last_used) {
+        if (++spins > 50000000U) {
+            fail("timeout", 0xDEAD);
+        }
+    }
+    ctrl_last_used = ctrl_used.idx;
+
+    /* Ack the interrupt */
+    u32 isr = mmio_read(VIRTIO_MMIO_INTERRUPT_STATUS);
+    if (isr & 1) {
+        mmio_write(VIRTIO_MMIO_INTERRUPT_ACK, 1);
+    }
+
+    return *(volatile u32*)resp_buf;
+}
+
+static u32 send_cursor(u32 cmd_len)
+{
+    cur_desc[0].addr = (u64)(uintptr_t)cmd_buf;
+    cur_desc[0].len = cmd_len;
+    cur_desc[0].flags = VIRTQ_DESC_F_NEXT;
+    cur_desc[0].next = 1;
+
+    cur_desc[1].addr = (u64)(uintptr_t)resp_buf;
+    cur_desc[1].len = sizeof(resp_buf);
+    cur_desc[1].flags = VIRTQ_DESC_F_WRITE;
+    cur_desc[1].next = 0;
+
+    barrier();
+
+    cur_avail.ring[cur_avail.idx % QNUM] = 0;
+    cur_avail.idx++;
+
+    barrier();
+
+    mmio_write(VIRTIO_MMIO_QUEUE_NOTIFY, 1);
+
+    u32 spins = 0;
+    while (cur_used.idx == cur_last_used) {
+        if (++spins > 50000000U) {
+            fail("cursor-timeout", 0xDEAD);
+        }
+    }
+    cur_last_used = cur_used.idx;
+
+    u32 isr = mmio_read(VIRTIO_MMIO_INTERRUPT_STATUS);
+    if (isr & 1) {
+        mmio_write(VIRTIO_MMIO_INTERRUPT_ACK, 1);
+    }
+
+    return *(volatile u32*)resp_buf;
+}
+
+static u32 le32(const u8* p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static void wr32(u8* p, u32 v)
+{
+    p[0] = (u8)(v);
+    p[1] = (u8)(v >> 8);
+    p[2] = (u8)(v >> 16);
+    p[3] = (u8)(v >> 24);
+}
+
+void payload_main(void)
+{
+    uart_puts("VGTEST: start\n");
+
+    /* 1. Device identification */
+    u32 magic = mmio_read(VIRTIO_MMIO_MAGIC);
+    u32 version = mmio_read(VIRTIO_MMIO_VERSION);
+    u32 devid = mmio_read(VIRTIO_MMIO_DEVICE_ID);
+    u32 vendor = mmio_read(VIRTIO_MMIO_VENDOR_ID);
+    if (magic != 0x74726976 || version != 2 || devid != 0x10 || vendor != 0x5256564d) {
+        fail("ident", (magic << 0) | (version << 8));
+    }
+    ok("T1 ident");
+
+    /* 2. Feature negotiation */
+    mmio_write(VIRTIO_MMIO_STATUS, 0);
+    mmio_write(VIRTIO_MMIO_STATUS, VIRTIO_STATUS_ACK | VIRTIO_STATUS_DRIVER);
+
+    mmio_write(VIRTIO_MMIO_DEVICE_FEATURES_SEL, 0);
+    u32 feat_lo = mmio_read(VIRTIO_MMIO_DEVICE_FEATURES);
+    mmio_write(VIRTIO_MMIO_DEVICE_FEATURES_SEL, 1);
+    u32 feat_hi = mmio_read(VIRTIO_MMIO_DEVICE_FEATURES);
+
+    if (!(feat_lo & (1U << 1))) {
+        fail("edid-feature", feat_lo);
+    }
+    /* Accept EDID(bit1) + INDIRECT(28) + EVENT_IDX(29); no virgl */
+    u32 drv_lo = feat_lo & ((1U << 1) | (1U << 28) | (1U << 29));
+    u32 drv_hi = feat_hi & (1U << 0); /* VIRTIO_F_VERSION_1 */
+
+    mmio_write(VIRTIO_MMIO_DRIVER_FEATURES_SEL, 0);
+    mmio_write(VIRTIO_MMIO_DRIVER_FEATURES, drv_lo);
+    mmio_write(VIRTIO_MMIO_DRIVER_FEATURES_SEL, 1);
+    mmio_write(VIRTIO_MMIO_DRIVER_FEATURES, drv_hi);
+
+    mmio_write(VIRTIO_MMIO_STATUS, VIRTIO_STATUS_ACK | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK);
+    if (!(mmio_read(VIRTIO_MMIO_STATUS) & VIRTIO_STATUS_FEATURES_OK)) {
+        fail("features-ok", mmio_read(VIRTIO_MMIO_STATUS));
+    }
+    ok("T2 features");
+
+    /* 3. Queue setup */
+    setup_queue(0, ctrl_desc, &ctrl_avail, &ctrl_used);
+    setup_queue(1, cur_desc, &cur_avail, &cur_used);
+    mmio_write(VIRTIO_MMIO_STATUS,
+               VIRTIO_STATUS_ACK | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK | VIRTIO_STATUS_DRIVER_OK);
+    ok("T3 queues");
+
+    /* 4. GET_DISPLAY_INFO */
+    wr32(cmd_buf + 0, CMD_GET_DISPLAY_INFO);
+    u32 r = send_ctrl(24);
+    if (r != RESP_OK_DISPLAY_INFO) {
+        fail("T4 display-info", r);
+    }
+    /* hdr(24) + pmode[0] {x,y,w,h,enabled,flags} */
+    u32 dw = le32(resp_buf + 24 + 8);
+    u32 dh = le32(resp_buf + 24 + 12);
+    u32 en = le32(resp_buf + 24 + 16);
+    u32 en1 = le32(resp_buf + 24 + 24 + 16);
+    if (dw != 1280 || dh != 800 || en != 1 || en1 != 0) {
+        fail("T4 display-info-values", (dw << 0) | (dh << 16));
+    }
+    ok("T4 display-info");
+
+    /* 5. GET_EDID */
+    wr32(cmd_buf + 0, CMD_GET_EDID);
+    wr32(cmd_buf + 24, 0); /* scanout 0 */
+    r = send_ctrl(24 + 8);
+    if (r != RESP_OK_EDID) {
+        fail("T5 edid", r);
+    }
+    u32 esize = le32(resp_buf + 24);
+    if (esize != 128) {
+        fail("T5 edid-size", esize);
+    }
+    const u8* edid = resp_buf + 32;
+    if (edid[0] != 0x00 || edid[1] != 0xFF || edid[2] != 0xFF || edid[3] != 0xFF || edid[7] != 0x00) {
+        fail("T5 edid-header", edid[1]);
+    }
+    u32 sum = 0;
+    for (u32 i = 0; i < 128; i++) {
+        sum += edid[i];
+    }
+    if ((sum & 0xFF) != 0) {
+        fail("T5 edid-checksum", sum & 0xFF);
+    }
+    ok("T5 edid");
+
+    /* 6. RESOURCE_UNREF on nonexistent id -> error */
+    wr32(cmd_buf + 0, CMD_RESOURCE_UNREF);
+    wr32(cmd_buf + 24, 42); /* nonexistent resource id */
+    r = send_ctrl(24 + 8);
+    if (r != RESP_ERR_INVALID_RESOURCE_ID) {
+        fail("T6 unref-bad-id", r);
+    }
+    ok("T6 unref-bad-id");
+
+    /* 7. RESOURCE_CREATE_2D 64x64 B8G8R8X8 */
+    wr32(cmd_buf + 0, CMD_RESOURCE_CREATE_2D);
+    wr32(cmd_buf + 24, 1); /* resource id */
+    wr32(cmd_buf + 28, FMT_B8G8R8X8);
+    wr32(cmd_buf + 32, 64);
+    wr32(cmd_buf + 36, 64);
+    r = send_ctrl(24 + 16);
+    if (r != RESP_OK_NODATA) {
+        fail("T7 create-2d", r);
+    }
+    ok("T7 create-2d");
+
+    /* 8. ATTACH_BACKING */
+    wr32(cmd_buf + 0, CMD_RESOURCE_ATTACH_BACKING);
+    wr32(cmd_buf + 24, 1);  /* resource id */
+    wr32(cmd_buf + 28, 1);  /* nr_entries */
+    wr32(cmd_buf + 32, (u32)((u64)(uintptr_t)fb64 & 0xFFFFFFFFU));
+    wr32(cmd_buf + 36, (u32)((u64)(uintptr_t)fb64 >> 32));
+    wr32(cmd_buf + 40, 64 * 64 * 4);
+    wr32(cmd_buf + 44, 0);
+    r = send_ctrl(24 + 8 + 16);
+    if (r != RESP_OK_NODATA) {
+        fail("T8 attach-backing", r);
+    }
+    ok("T8 attach-backing");
+
+    /* 9. Fill guest buffer: pixel(x,y) = {B=0xFF-2y, G=4x, R=0x80, X=0} */
+    for (u32 y = 0; y < 64; y++) {
+        for (u32 x = 0; x < 64; x++) {
+            u32 px = (0x80U << 16) | ((x * 4) << 8) | (0xFFU - 2 * y);
+            fb64[y * 64 + x] = px;
+        }
+    }
+
+    /* 10. TRANSFER_TO_HOST_2D with fence */
+    wr32(cmd_buf + 0, CMD_TRANSFER_TO_HOST_2D);
+    wr32(cmd_buf + 4, 1); /* VIRTIO_GPU_FLAG_FENCE */
+    *(volatile u64*)(cmd_buf + 8) = 0x1234; /* fence id */
+    wr32(cmd_buf + 24, 0); /* rect.x */
+    wr32(cmd_buf + 28, 0); /* rect.y */
+    wr32(cmd_buf + 32, 64); /* rect.w */
+    wr32(cmd_buf + 36, 64); /* rect.h */
+    *(volatile u64*)(cmd_buf + 40) = 0; /* offset */
+    wr32(cmd_buf + 48, 1); /* resource id */
+    r = send_ctrl(24 + 32);
+    if (r != RESP_OK_NODATA) {
+        fail("T10 transfer", r);
+    }
+    u64 rfid = *(volatile u64*)(resp_buf + 8);
+    if (rfid != 0x1234) {
+        fail("T10 fence-id", (u32)rfid);
+    }
+    ok("T10 transfer+fence");
+
+    /* 11. SET_SCANOUT */
+    wr32(cmd_buf + 0, CMD_SET_SCANOUT);
+    wr32(cmd_buf + 24, 0);
+    wr32(cmd_buf + 28, 0);
+    wr32(cmd_buf + 32, 64);
+    wr32(cmd_buf + 36, 64);
+    wr32(cmd_buf + 40, 0); /* scanout id */
+    wr32(cmd_buf + 44, 1); /* resource id */
+    r = send_ctrl(24 + 24);
+    if (r != RESP_OK_NODATA) {
+        fail("T11 set-scanout", r);
+    }
+    ok("T11 set-scanout");
+
+    /* 12. FLUSH */
+    wr32(cmd_buf + 0, CMD_RESOURCE_FLUSH);
+    wr32(cmd_buf + 24, 0);
+    wr32(cmd_buf + 28, 0);
+    wr32(cmd_buf + 32, 64);
+    wr32(cmd_buf + 36, 64);
+    wr32(cmd_buf + 40, 1); /* resource id */
+    wr32(cmd_buf + 44, 0); /* padding */
+    r = send_ctrl(24 + 24);
+    if (r != RESP_OK_NODATA) {
+        fail("T12 flush", r);
+    }
+    ok("T12 flush");
+
+    /* 13. Cursor: create 8x8 A8R8G8B8 resource, attach, transfer, update, move */
+    wr32(cmd_buf + 0, CMD_RESOURCE_CREATE_2D);
+    wr32(cmd_buf + 24, 3); /* resource id */
+    wr32(cmd_buf + 28, FMT_A8R8G8B8);
+    wr32(cmd_buf + 32, 8);
+    wr32(cmd_buf + 36, 8);
+    r = send_ctrl(24 + 16);
+    if (r != RESP_OK_NODATA) {
+        fail("T13 cursor-create", r);
+    }
+
+    wr32(cmd_buf + 0, CMD_RESOURCE_ATTACH_BACKING);
+    wr32(cmd_buf + 24, 3);
+    wr32(cmd_buf + 28, 1);
+    wr32(cmd_buf + 32, (u32)((u64)(uintptr_t)cursor_img & 0xFFFFFFFFU));
+    wr32(cmd_buf + 36, (u32)((u64)(uintptr_t)cursor_img >> 32));
+    wr32(cmd_buf + 40, 8 * 8 * 4);
+    wr32(cmd_buf + 44, 0);
+    r = send_ctrl(24 + 8 + 16);
+    if (r != RESP_OK_NODATA) {
+        fail("T13 cursor-attach", r);
+    }
+
+    for (u32 i = 0; i < 64; i++) {
+        cursor_img[i] = 0xFF00FF00U; /* opaque green {A=0,R=FF,G=0,B=0}? see A8R8G8B8 layout */
+    }
+
+    wr32(cmd_buf + 0, CMD_TRANSFER_TO_HOST_2D);
+    wr32(cmd_buf + 4, 0);
+    *(volatile u64*)(cmd_buf + 8) = 0;
+    wr32(cmd_buf + 24, 0);
+    wr32(cmd_buf + 28, 0);
+    wr32(cmd_buf + 32, 8);
+    wr32(cmd_buf + 36, 8);
+    *(volatile u64*)(cmd_buf + 40) = 0;
+    wr32(cmd_buf + 48, 3);
+    r = send_ctrl(24 + 32);
+    if (r != RESP_OK_NODATA) {
+        fail("T13 cursor-transfer", r);
+    }
+
+    /* UPDATE_CURSOR on the cursor queue */
+    wr32(cmd_buf + 0, CMD_UPDATE_CURSOR);
+    wr32(cmd_buf + 24, 0xFFFFFFFFU); /* pos.scanout_id (all) */
+    wr32(cmd_buf + 28, 10);          /* pos.x */
+    wr32(cmd_buf + 32, 20);          /* pos.y */
+    wr32(cmd_buf + 36, 0);           /* pos.padding */
+    wr32(cmd_buf + 40, 3);           /* resource id */
+    wr32(cmd_buf + 44, 2);           /* hot_x */
+    wr32(cmd_buf + 48, 2);           /* hot_y */
+    wr32(cmd_buf + 52, 0);           /* padding */
+    r = send_cursor(24 + 32);
+    if (r != RESP_OK_NODATA) {
+        fail("T13 cursor-update", r);
+    }
+
+    /* MOVE_CURSOR */
+    wr32(cmd_buf + 0, CMD_MOVE_CURSOR);
+    wr32(cmd_buf + 24, 0xFFFFFFFFU);
+    wr32(cmd_buf + 28, 30);
+    wr32(cmd_buf + 32, 40);
+    wr32(cmd_buf + 36, 0);
+    wr32(cmd_buf + 40, 3);
+    r = send_cursor(24 + 24);
+    if (r != RESP_OK_NODATA) {
+        fail("T13 cursor-move", r);
+    }
+    ok("T13 cursor");
+
+    uart_puts("VGTEST: ALL PASS\n");
+    for (;;) {
+        __asm__ volatile("wfi");
+    }
+}
+
+__attribute__((naked, section(".text.init"))) void _start(void)
+{
+    __asm__ volatile(
+        ".option push\n"
+        ".option norelax\n"
+        "la gp, __global_pointer$\n"
+        ".option pop\n"
+        "la sp, __stack_top\n"
+        "call payload_main\n"
+        "1: wfi\n"
+        "j 1b\n");
+}
+
+/* 16KiB stack, exported top address for _start */
+u8 stack[16384] __attribute__((aligned(16), used));
+__asm__(".globl __stack_top\n.set __stack_top, stack + 16384\n");
