+    ops->resource_create_3d = vg_vg_resource_create_3d;
+    ops->resource_attach_backing = vg_vg_resource_attach_backing;
+    ops->resource_detach_backing = vg_vg_resource_detach_backing;
+    ops->resource_transfer_read = vg_vg_resource_transfer_read;
+    ops->resource_transfer_write = vg_vg_resource_transfer_write;
+    ops->resource_create_blob = vg_vg_resource_create_blob;
+    ops->resource_unref = vg_vg_resource_unref;
+    ops->resource_map = vg_vg_resource_map;
+    ops->resource_unmap = vg_vg_resource_unmap;
+    ops->resource_map_info = vg_vg_resource_map_info;
+    ops->submit_command = vg_vg_submit_command;
+    ops->create_fence = vg_vg_create_fence;
