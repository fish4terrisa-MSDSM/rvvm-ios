+PUBLIC bool virtio_gpu_init_virgl(rvvm_mmio_dev_t* dev, const char* libpath, uint32_t backend_mask)
+{
+    if (!dev || !dev->data || dev->type != &virtio_gpu_type) {
+        return false;
+    }
+#ifdef VIRGL_BRIDGE
+    virtio_gpu_dev_t* vg = dev->data;
+    if (vg->rtb) {
+        return true;
+    }
+    if (vg->status != 0) {
+        rvvm_warn("virtio-gpu: cannot attach virglrenderer after driver init");
+        return false;
+    }
+    if (backend_mask == 0) {
+        backend_mask = VG3D_VIRGL | VG3D_VENUS;
+    }
+    bool ok = vg_virgl_load(vg, libpath, backend_mask);
+    if (ok) {
+        vg->config_generation++;
+    }
+    return ok;
+#else
+    UNUSED(dev);
+    UNUSED(libpath);
+    UNUSED(backend_mask);
+    return false;
+#endif
