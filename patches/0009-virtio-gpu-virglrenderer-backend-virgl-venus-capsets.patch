@@ -320,9 +340,14 @@ typedef struct {
 
 #ifdef RUTABAGA_BRIDGE
     struct rutabaga_rv_bridge* rtb;
+    uint32_t g3d_kind; // 0 = none, 1 = rutabaga, 2 = virgl/venus
 #endif
 } virtio_gpu_dev_t;
 
+#define G3D_NONE     0
+#define G3D_RUTABAGA 1
+#define G3D_VIRGL    2
+
 /*
  * Virtqueue helpers
  */
@@ -561,7 +586,9 @@ static void vg_resource_unref(virtio_gpu_dev_t* vg, virtio_gpu_resource_t* res)
     }
 #ifdef RUTABAGA_BRIDGE
     if (vg->rtb && res->is_3d) {
-        vg->rtb->resource_detach_backing(vg->rtb->rata, res->id);
+        if (!res->blob) {
+            vg->rtb->resource_detach_backing(vg->rtb->rata, res->id);
+        }
         vg->rtb->resource_unref(vg->rtb->rata, res->id);
     }
 #else
@@ -961,8 +988,593 @@ static bool vg_rutabaga_load(virtio_gpu_dev_t* vg, const char* libpath)
 
     rtb->dl = dl;
     vg->rtb = rtb;
+    vg->g3d_kind = G3D_RUTABAGA;
     // Advertise virgl acceleration to the guest
     vg->host_features[0] |= 1U << VIRTIO_GPU_F_VIRGL;
+    vg->host_features[0] |= 1U << VIRTIO_GPU_F_RESOURCE_BLOB;
+    vg->host_features[0] |= 1U << VIRTIO_GPU_F_CONTEXT_INIT;
+    return true;
+}
+#endif
+
+
+#ifdef VIRGL_BRIDGE
+/*
+ * Virglrenderer backend bridge (virgl + venus).
+ *
+ * Implements the same internal 3D ops shape as the rutabaga bridge on top of
+ * libvirglrenderer, which hosts BOTH the classic virgl (Gallium/GLES) path
+ * and the venus (Vulkan command serialization) path. On iOS the venus path
+ * runs on top of MoltenVK - no Metal API is used by RVVM itself.
+ */
+struct virgl_rv_state {
+    void* dl;
+    uint32_t want_mask; // VG3D_VIRGL | VG3D_VENUS
+    struct {
+        int (*init)(void* cookie, int flags, void* cb);
+        void (*cleanup)(void* cookie);
+        void (*poll)(void);
+        int (*context_create_with_flags)(uint32_t ctx_id, uint32_t ctx_flags, uint32_t nlen, const char* name);
+        void (*context_destroy)(uint32_t handle);
+        int (*ctx_attach_resource)(int ctx_id, int res_handle);
+        void (*ctx_detach_resource)(int ctx_id, int res_handle);
+        int (*resource_create)(void* args, void* iov, uint32_t num_iovs);
+        void (*resource_unref)(uint32_t res_handle);
+        int (*resource_attach_iov)(int res_handle, void* iov, int num_iovs);
+        void (*resource_detach_iov)(int res_handle, void** iov, int* num_iovs);
+        int (*transfer_read_iov)(uint32_t handle, uint32_t ctx_id, uint32_t level, uint32_t stride,
+                                 uint32_t layer_stride, void* box, uint64_t offset, void* iov, int iovec_cnt);
+        int (*transfer_write_iov)(uint32_t handle, uint32_t ctx_id, int level, uint32_t stride,
+                                  uint32_t layer_stride, void* box, uint64_t offset, void* iovec,
+                                  unsigned int iovec_cnt);
+        int (*submit_cmd)(void* buffer, int ctx_id, int ndw);
+        int (*create_fence)(int client_fence_id, uint32_t ctx_id);
+        void (*get_cap_set)(uint32_t set, uint32_t* max_ver, uint32_t* max_size);
+        void (*fill_caps)(uint32_t set, uint32_t version, void* caps);
+        int (*resource_create_blob)(const void* args);
+        int (*resource_map)(uint32_t res_handle, void** map, uint64_t* out_size);
+        int (*resource_unmap)(uint32_t res_handle);
+        int (*resource_get_map_info)(uint32_t res_handle, uint32_t* map_info);
+        int (*context_create_fence)(uint32_t ctx_id, uint32_t flags, uint32_t ring_idx, uint64_t fence_id);
+    } fn;
+};
+
+#define VG3D_VIRGL 1
+#define VG3D_VENUS 2
+
+// capset enumeration for the virgl/venus backend
+static const uint32_t vg_virgl_capsets[] = { VG_CAPSET_VIRGL, VG_CAPSET_VIRGL2, VG_CAPSET_VENUS };
+
+static void vg_virgl_write_fence(void* cookie, uint32_t fence)
+{
+    UNUSED(cookie);
+    UNUSED(fence);
+    // Fences are completed synchronously in the request path
+}
+
+static void vg_virgl_write_context_fence(void* cookie, uint32_t ctx_id, uint32_t ring_idx, uint64_t fence_id)
+{
+    UNUSED(cookie);
+    UNUSED(ctx_id);
+    UNUSED(ring_idx);
+    UNUSED(fence_id);
+}
+
+// virgl_renderer_callbacks: only the leading fence callbacks are needed when
+// virglrenderer owns its winsys (or for venus-only operation).
+typedef struct {
+    void (*write_fence)(void* cookie, uint32_t fence);
+    void* create_gl_context;
+    void* destroy_gl_context;
+    void* make_current;
+    void* get_drm_fd;
+    void (*write_context_fence)(void* cookie, uint32_t ctx_id, uint32_t ring_idx, uint64_t fence_id);
+} vg_virgl_callbacks_t;
+
+static int32_t vg_vg_get_num_capsets(struct rutabaga* ptr, uint32_t* num)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !num) {
+        return -1;
+    }
+    uint32_t count = 0;
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg_virgl_capsets); ++i) {
+        uint32_t ver = 0, size = 0;
+        uint32_t id = vg_virgl_capsets[i];
+        if ((id == VG_CAPSET_VENUS && !(st->want_mask & VG3D_VENUS)) ||
+            (id != VG_CAPSET_VENUS && !(st->want_mask & VG3D_VIRGL))) {
+            continue;
+        }
+        st->fn.get_cap_set(id, &ver, &size);
+        if (size > 0) {
+            ++count;
+        }
+    }
+    *num = count;
+    return 0;
+}
+
+static int32_t vg_vg_get_capset_info(struct rutabaga* ptr, uint32_t idx, uint32_t* id, uint32_t* ver, uint32_t* size)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !id || !ver || !size) {
+        return -1;
+    }
+    uint32_t count = 0;
+    for (size_t i = 0; i < STATIC_ARRAY_SIZE(vg_virgl_capsets); ++i) {
+        uint32_t cid = vg_virgl_capsets[i];
+        if ((cid == VG_CAPSET_VENUS && !(st->want_mask & VG3D_VENUS)) ||
+            (cid != VG_CAPSET_VENUS && !(st->want_mask & VG3D_VIRGL))) {
+            continue;
+        }
+        uint32_t cver = 0, csize = 0;
+        st->fn.get_cap_set(cid, &cver, &csize);
+        if (csize == 0) {
+            continue;
+        }
+        if (count == idx) {
+            *id = cid;
+            *ver = cver;
+            *size = csize;
+            return 0;
+        }
+        ++count;
+    }
+    return -1;
+}
+
+static int32_t vg_vg_get_capset(struct rutabaga* ptr, uint32_t id, uint32_t version, uint8_t* capset, uint32_t size)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !capset || !size) {
+        return -1;
+    }
+    uint32_t ver = 0, csize = 0;
+    st->fn.get_cap_set(id, &ver, &csize);
+    if (csize == 0 || csize > size) {
+        return -1;
+    }
+    memset(capset, 0, size);
+    st->fn.fill_caps(id, version, capset);
+    return 0;
+}
+
+static int32_t vg_vg_context_create(struct rutabaga* ptr, uint32_t ctx_id, uint32_t context_init, const char* name,
+                                    uint32_t name_len)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st) {
+        return -1;
+    }
+    // context_init carries the capset id in the low 8 bits
+    uint32_t capset = context_init & 0xff;
+    if (capset == 0) {
+        capset = VG_CAPSET_VIRGL;
+    }
+    char namebuf[65];
+    if (!name || name_len == 0) {
+        namebuf[0] = 0;
+        name = namebuf;
+    } else {
+        if (name_len > 64) {
+            name_len = 64;
+        }
+        memcpy(namebuf, name, name_len);
+        namebuf[name_len] = 0;
+        name = namebuf;
+    }
+    return st->fn.context_create_with_flags(ctx_id, capset, name_len, name) ? -1 : 0;
+}
+
+static int32_t vg_vg_context_destroy(struct rutabaga* ptr, uint32_t ctx_id)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st) {
+        return -1;
+    }
+    st->fn.context_destroy(ctx_id);
+    return 0;
+}
+
+static int32_t vg_vg_context_attach_resource(struct rutabaga* ptr, uint32_t ctx_id, uint32_t res_id)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st) {
+        return -1;
+    }
+    return st->fn.ctx_attach_resource((int)ctx_id, (int)res_id) ? -1 : 0;
+}
+
+static int32_t vg_vg_context_detach_resource(struct rutabaga* ptr, uint32_t ctx_id, uint32_t res_id)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st) {
+        return -1;
+    }
+    st->fn.ctx_detach_resource((int)ctx_id, (int)res_id);
+    return 0;
+}
+
+static int32_t vg_vg_resource_create_3d(struct rutabaga* ptr, uint32_t res_id, const void* create_3d)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !create_3d) {
+        return -1;
+    }
+    // create_3d: {target,format,bind,w,h,depth,array_size,last_level,nr_samples,flags}
+    const uint32_t* c3d = (const uint32_t*)create_3d;
+    uint32_t args[11] = {
+        res_id, c3d[0], c3d[1], c3d[2], c3d[3], c3d[4], c3d[5], c3d[6], c3d[7], c3d[8], c3d[9],
+    };
+    return st->fn.resource_create(args, NULL, 0) ? -1 : 0;
+}
+
+static int32_t vg_vg_resource_attach_backing(struct rutabaga* ptr, uint32_t res_id, const void* iovecs)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !iovecs) {
+        return -1;
+    }
+    // iovecs: { void* vecs; size_t count; } with vecs[] = { void* base; size_t len; }
+    struct {
+        void* vecs;
+        size_t count;
+    }* io = (void*)(uintptr_t)iovecs;
+    return st->fn.resource_attach_iov((int)res_id, io->vecs, (int)io->count) ? -1 : 0;
+}
+
+static int32_t vg_vg_resource_detach_backing(struct rutabaga* ptr, uint32_t res_id)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st) {
+        return -1;
+    }
+    st->fn.resource_detach_iov((int)res_id, NULL, NULL);
+    return 0;
+}
+
+static int32_t vg_vg_resource_transfer_read(struct rutabaga* ptr, uint32_t ctx_id, uint32_t res_id,
+                                            const void* transfer, const void* iovec)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !transfer || !iovec) {
+        return -1;
+    }
+    // transfer: {x,y,z,w,h,d,level,stride,layer_stride,pad,offset u64}
+    const uint8_t* t = (const uint8_t*)transfer;
+    uint32_t box[6];
+    memcpy(box, t, 24);
+    uint32_t level, stride, layer_stride;
+    memcpy(&level, t + 24, 4);
+    memcpy(&stride, t + 28, 4);
+    memcpy(&layer_stride, t + 32, 4);
+    uint64_t offset;
+    memcpy(&offset, t + 40, 8);
+    return st->fn.transfer_read_iov(res_id, ctx_id, level, stride, layer_stride, box, offset,
+                                    (void*)(uintptr_t)iovec, 1)
+               ? -1
+               : 0;
+}
+
+static int32_t vg_vg_resource_transfer_write(struct rutabaga* ptr, uint32_t ctx_id, uint32_t res_id,
+                                             const void* transfer)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !transfer) {
+        return -1;
+    }
+    const uint8_t* t = (const uint8_t*)transfer;
+    uint32_t box[6];
+    memcpy(box, t, 24);
+    uint32_t level, stride, layer_stride;
+    memcpy(&level, t + 24, 4);
+    memcpy(&stride, t + 28, 4);
+    memcpy(&layer_stride, t + 32, 4);
+    uint64_t offset;
+    memcpy(&offset, t + 40, 8);
+    // Data is taken from the attached backing iovs
+    return st->fn.transfer_write_iov(res_id, ctx_id, (int)level, stride, layer_stride, box, offset, NULL, 0)
+               ? -1
+               : 0;
+}
+
+static int32_t vg_vg_resource_create_blob(struct rutabaga* ptr, uint32_t ctx_id, uint32_t res_id,
+                                          const void* create_blob, const void* iovecs, const void* handle)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !create_blob) {
+        return -1;
+    }
+    UNUSED(handle);
+    // create_blob: {blob_mem u32, blob_flags u32, blob_id u64, size u64}
+    struct {
+        uint32_t blob_mem;
+        uint32_t blob_flags;
+        uint64_t blob_id;
+        uint64_t size;
+    } cb;
+    memcpy(&cb, create_blob, sizeof(cb));
+    void* iov_ptr = NULL;
+    uint32_t iov_cnt = 0;
+    if (iovecs) {
+        struct {
+            void* vecs;
+            size_t count;
+        }* io = (void*)(uintptr_t)iovecs;
+        iov_ptr = io->vecs;
+        iov_cnt = (uint32_t)io->count;
+    }
+    // struct virgl_renderer_resource_create_blob_args
+    struct {
+        uint32_t res_handle;
+        uint32_t ctx_id;
+        uint32_t blob_mem;
+        uint32_t blob_flags;
+        uint64_t blob_id;
+        uint64_t size;
+        const void* iovecs;
+        uint32_t num_iovs;
+    } args = {
+        res_id, ctx_id, cb.blob_mem, cb.blob_flags, cb.blob_id, cb.size, iov_ptr, iov_cnt,
+    };
+    return st->fn.resource_create_blob(&args) ? -1 : 0;
+}
+
+static int32_t vg_vg_resource_unref(struct rutabaga* ptr, uint32_t res_id)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st) {
+        return -1;
+    }
+    st->fn.resource_unref(res_id);
+    return 0;
+}
+
+static int32_t vg_vg_resource_map(struct rutabaga* ptr, uint32_t res_id, void* mapping)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !mapping) {
+        return -1;
+    }
+    // mapping: { uint64_t ptr; uint64_t size; } (rutabaga_mapping)
+    void* map = NULL;
+    uint64_t size = 0;
+    if (st->fn.resource_map(res_id, &map, &size)) {
+        return -1;
+    }
+    uint64_t out[2] = { (uint64_t)(uintptr_t)map, size };
+    memcpy(mapping, out, sizeof(out));
+    return 0;
+}
+
+static int32_t vg_vg_resource_unmap(struct rutabaga* ptr, uint32_t res_id)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st) {
+        return -1;
+    }
+    return st->fn.resource_unmap(res_id) ? -1 : 0;
+}
+
+static int32_t vg_vg_resource_map_info(struct rutabaga* ptr, uint32_t res_id, uint32_t* map_info)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !map_info) {
+        return -1;
+    }
+    return st->fn.resource_get_map_info(res_id, map_info) ? -1 : 0;
+}
+
+static int32_t vg_vg_submit_command(struct rutabaga* ptr, void* cmd)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !cmd) {
+        return -1;
+    }
+    // cmd: {ctx_id, cmd_size, cmd*}
+    struct {
+        uint32_t ctx_id;
+        uint32_t cmd_size;
+        uint8_t* cmdbuf;
+    }* c = (void*)(uintptr_t)cmd;
+    if (!c->cmdbuf || c->cmd_size == 0 || (c->cmd_size & 3)) {
+        return -1;
+    }
+    return st->fn.submit_cmd(c->cmdbuf, (int)c->ctx_id, (int)(c->cmd_size / 4)) ? -1 : 0;
+}
+
+static int32_t vg_vg_create_fence(struct rutabaga* ptr, const void* fence)
+{
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)ptr;
+    if (!st || !fence) {
+        return -1;
+    }
+    // fence: {flags u32, pad u32, fence_id u64, ctx_id u32, ring_idx u32}
+    const uint8_t* f = (const uint8_t*)fence;
+    uint64_t fence_id;
+    uint32_t ctx_id, ring_idx;
+    memcpy(&fence_id, f + 8, 8);
+    memcpy(&ctx_id, f + 16, 4);
+    memcpy(&ring_idx, f + 20, 4);
+    if (st->fn.context_create_fence) {
+        return st->fn.context_create_fence(ctx_id, 0, ring_idx, fence_id) ? -1 : 0;
+    }
+    return st->fn.create_fence((int)(fence_id & 0xFFFFFFFFU), ctx_id) ? -1 : 0;
+}
+
+static int32_t vg_vg_finish(struct rutabaga** ptr)
+{
+    if (!ptr || !*ptr) {
+        return -1;
+    }
+    struct virgl_rv_state* st = (struct virgl_rv_state*)(uintptr_t)*ptr;
+    st->fn.cleanup(NULL);
+    if (st->dl) {
+        dlclose(st->dl);
+    }
+    free(st);
+    *ptr = NULL;
+    return 0;
+}
+
+static int32_t vg_vg_init(const void* builder, struct rutabaga** ptr)
+{
+    const struct rutabaga_builder_rv* b = (const struct rutabaga_builder_rv*)builder;
+    if (!b || !ptr) {
+        return -1;
+    }
+    struct virgl_rv_state* st = (struct virgl_rv_state*)b->user_data;
+    // user_data carries the prepared virgl state (set up in vg_virgl_load)
+    if (!st) {
+        return -1;
+    }
+    // Flags: surfaceless + GLES winsys for virgl; venus renderer enabled as
+    // requested. VIRGL_RENDERER_NO_VIRGL when only venus is wanted.
+    int flags = 0;
+    if (st->want_mask & VG3D_VIRGL) {
+        flags |= (1 << 0) /* USE_EGL */ | (1 << 3) /* USE_SURFACELESS */ | (1 << 4) /* USE_GLES */;
+    }
+    if (st->want_mask & VG3D_VENUS) {
+        flags |= (1 << 5) /* USE_EXTERNAL_BLOB */ | (1 << 6) /* VIRGL_RENDERER_VENUS */;
+    }
+    if (!(st->want_mask & VG3D_VIRGL) && (st->want_mask & VG3D_VENUS)) {
