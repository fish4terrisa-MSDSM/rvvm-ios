diff --git a/src/devices/tap_api.h b/src/devices/tap_api.h
index a25d975..bd59f37 100644
--- a/src/devices/tap_api.h
+++ b/src/devices/tap_api.h
@@ -42,6 +42,9 @@ PUBLIC bool tap_set_mac(tap_dev_t* tap, const uint8_t mac[6]);
 // Format: "tcp/2022=22"; "[::1]:2022=22"; "127.0.0.1:2022=192.168.0.101:22"
