diff --git a/src/devices/bochs-display.c b/src/devices/bochs-display.c
index 042d772..2cb70fc 100644
--- a/src/devices/bochs-display.c
+++ b/src/devices/bochs-display.c
@@ -232,10 +232,46 @@ static void bochs_display_poll(rvvm_reg_dev_t* dev)
     rvvm_fbdev_update(disp->fbdev);
 }
 
+static void bochs_vram_suspend(rvvm_reg_dev_t* dev, rvvm_snapshot_t* snap, bool resume)
+{
+    if (snap) {
+        bochs_display_t* disp = rvvm_region_data(dev);
+        rvvm_reg_desc_t desc  = ZERO_INIT;
+        rvvm_region_get_desc(dev, &desc);
+        if (desc.mmap && desc.size && !rvvm_fbdev_is_headless(disp->fbdev)) {
+            rvvm_snapshot_section(snap, "bochs-vram");
+            rvvm_snapshot_data(snap, desc.mmap, desc.size);
+        }
+    }
+    UNUSED(resume);
+}
+
+static void bochs_display_suspend(rvvm_reg_dev_t* dev, rvvm_snapshot_t* snap, bool resume)
+{
+    bochs_display_t* disp = rvvm_region_data(dev);
+
+    if (snap) {
+        rvvm_snapshot_section(snap, "bochs-display");
+        rvvm_snapshot_field(snap, disp->version);
+        rvvm_snapshot_field(snap, disp->enable);
+        rvvm_snapshot_field(snap, disp->xres);
+        rvvm_snapshot_field(snap, disp->yres);
+        rvvm_snapshot_field(snap, disp->xvirt);
+        rvvm_snapshot_field(snap, disp->yvirt);
+        rvvm_snapshot_field(snap, disp->xoff);
+        rvvm_snapshot_field(snap, disp->yoff);
+    } else if (resume) {
+        bochs_display_update_mode(disp, !!(disp->enable & BOCHS_ENABLE));
+        rvvm_fbdev_dirty(disp->fbdev);
+    }
+}
+
 static const rvvm_reg_type_t bochs_vram_type = {
-    .name    = "bochs-vram",
-    .write   = bochs_vram_write,
-    .cleanup = bochs_display_cleanup,
+    .name     = "bochs-vram",
+    .write    = bochs_vram_write,
+    .poll     = bochs_display_poll,
+    .suspend  = bochs_vram_suspend,
+    .cleanup  = bochs_display_cleanup,
 };
 
 static const rvvm_reg_type_t bochs_display_type = {
@@ -243,6 +279,7 @@ static const rvvm_reg_type_t bochs_display_type = {
     .read     = bochs_display_read,
     .write    = bochs_display_write,
     .poll     = bochs_display_poll,
+    .suspend  = bochs_display_suspend,
     .cleanup  = bochs_display_cleanup,
     .min_size = 2,
     .max_size = 2,
