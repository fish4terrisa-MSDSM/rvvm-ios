 src/core/rvvm_fbdev.c       |  5 +++++
 src/core/rvvm_isolation.c   | 11 ++++++++++
 src/devices/bochs-display.c | 43 ++++++++++++++++++++++++++++++++++---
 src/util/blk_io.c           |  1 +
 src/util/networking.c       |  9 ++++----
 src/util/networking.h       |  4 ++--
 7 files changed, 69 insertions(+), 9 deletions(-)

